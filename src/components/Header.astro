---
import { site } from "../config/site";

interface Props {
  active?:
    "home" | "products" | "crm" | "connect" | "services" | "about" | "contact";
}
const { active } = Astro.props;
const productsActive =
  active === "products" || active === "crm" || active === "connect";

const navLinks = [
  { href: "/services", label: "Services", key: "services" },
  { href: "/about", label: "About", key: "about" },
  { href: "/contact", label: "Contact", key: "contact" },
];

// Line icons for the desktop nav (inner SVG markup)
const navIcons: Record<string, string> = {
  products:
    '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
  services:
    '<path d="M12 3l1.9 4.6 4.6 1.9-4.6 1.9L12 16l-1.9-4.6-4.6-1.9 4.6-1.9Z"/><path d="M19 15l.8 2.2 2.2.8-2.2.8L19 21l-.8-2.2-2.2-.8 2.2-.8Z"/>',
  about:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  contact:
    '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
};
---

<div class="hdr-gradient-bar" aria-hidden="true"></div>
<header class="site-header" id="siteHeader">
  <div class="hdr-container">
    <a href="/" class="hdr-brand" aria-label={`${site.name} home`}>
      <img
        src="/images/logo.png"
        alt=""
        width="34"
        height="34"
        class="hdr-brand__img"
      />
      <span class="hdr-brand__name">{site.name}</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hdr-nav" aria-label="Primary">
      <div class="hdr-nav__dropdown" id="desktopDropdown">
        <button
          type="button"
          class:list={["hdr-nav__link", { "is-active": productsActive }]}
          id="desktopDropdownTrigger"
          aria-expanded="false"
        >
          <svg class="hdr-nav__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={navIcons.products}></svg>
          Products
          <svg class="hdr-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="hdr-dropdown-panel" id="desktopPanel">
          <a href="/storemate-crm" class:list={["hdr-dd-item", { "is-active": active === "crm" }]}>
            <span class="hdr-dd-icon hdr-dd-icon--crm" aria-hidden="true"></span>
            <span class="hdr-dd-text">
              <span class="hdr-dd-title">Storemate CRM</span>
              <span class="hdr-dd-sub">Jewellery business management</span>
            </span>
          </a>
          <a href="/storemate-connect" class:list={["hdr-dd-item", { "is-active": active === "connect" }]}>
            <span class="hdr-dd-icon hdr-dd-icon--connect" aria-hidden="true"></span>
            <span class="hdr-dd-text">
              <span class="hdr-dd-title">Storemate Connect</span>
              <span class="hdr-dd-sub">Instagram & WhatsApp automation</span>
            </span>
          </a>
          <a href="/products" class="hdr-dd-all">View all products <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>

      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={["hdr-nav__link", { "is-active": active === link.key }]}
          aria-current={active === link.key ? "page" : undefined}
        >
          <svg class="hdr-nav__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={navIcons[link.key]}></svg>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hdr-right">
      <a
        href={site.products.crm.url}
        class="hdr-account hdr-cta-desktop"
        aria-label="Log in to Storemate CRM"
        data-tip="Log in to CRM"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 21v-1a7 7 0 0 1 7-7h2a7 7 0 0 1 7 7v1"></path>
        </svg>
      </a>

      <a href="/contact" class="hdr-cta hdr-cta-desktop">
        <span class="hdr-cta__inner">
          <span class="hdr-cta__dot" aria-hidden="true"></span>
          <span class="hdr-cta__label">Let's Talk</span>
          <span class="hdr-cta__arrow" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M2 6H10M10 6L6.5 2.5M10 6L6.5 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M2 6H10M10 6L6.5 2.5M10 6L6.5 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </span>
      </a>

      <button
        class="hdr-burger"
        id="burgerBtn"
        type="button"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span class="hdr-burger__line"></span>
        <span class="hdr-burger__line"></span>
        <span class="hdr-burger__line"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav — floating slide-over sheet -->
<div class="mob" id="mobNav" aria-hidden="true">
  <div class="mob__overlay" id="mobOverlay"></div>
  <div class="mob__sheet" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="mob__head">
      <a href="/" class="hdr-brand">
        <img src="/images/logo.png" alt="" width="30" height="30" class="hdr-brand__img" />
        <span class="hdr-brand__name">{site.name}</span>
      </a>
      <button class="mob__x" id="mobClose" type="button" aria-label="Close menu">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 3L17 17M17 3L3 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <span class="mob__label mob__stagger" style="--i: 0">Menu</span>

    <nav class="mob__links" aria-label="Mobile">
      <div class="mob__accordion mob__stagger" style="--i: 1">
        <button
          type="button"
          class:list={["mob__link mob__acc-trigger", { "is-active": productsActive }]}
          id="mobAccTrigger"
          aria-expanded="false"
          aria-controls="mobAccBody"
        >
          <span class="mob__link-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" set:html={navIcons.products}></svg>
          </span>
          <span class="mob__link-label">Products</span>
          <svg class="hdr-caret" width="12" height="7" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="mob__acc-body" id="mobAccBody">
          <div class="mob__acc-inner">
            <div class="mob__products">
              <a href="/storemate-crm" class:list={["mob__product mob__product--crm", { "is-active": active === "crm" }]}>
                <span class="hdr-dd-icon hdr-dd-icon--crm" aria-hidden="true"></span>
                <span class="hdr-dd-title">Storemate CRM</span>
                <span class="hdr-dd-sub">Jewellery business management</span>
              </a>
              <a href="/storemate-connect" class:list={["mob__product mob__product--connect", { "is-active": active === "connect" }]}>
                <span class="hdr-dd-icon hdr-dd-icon--connect" aria-hidden="true"></span>
                <span class="hdr-dd-title">Storemate Connect</span>
                <span class="hdr-dd-sub">Instagram & WhatsApp automation</span>
              </a>
            </div>
            <a href="/products" class="hdr-dd-all">View all products <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
      </div>

      {navLinks.map((link, idx) => (
        <a
          href={link.href}
          class:list={["mob__link mob__stagger", { "is-active": active === link.key }]}
          style={`--i: ${idx + 2}`}
          aria-current={active === link.key ? "page" : undefined}
        >
          <span class="mob__link-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" set:html={navIcons[link.key]}></svg>
          </span>
          <span class="mob__link-label">{link.label}</span>
          <svg class="mob__link-arrow" width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 6H10M10 6L6.5 2.5M10 6L6.5 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      ))}
    </nav>

    <div class="mob__foot mob__stagger" style={`--i: ${navLinks.length + 2}`}>
      <div class="mob__card">
        <span class="mob__card-eyebrow"><span class="hdr-cta__dot" aria-hidden="true"></span> We're available</span>
        <p class="mob__card-title">Have a project in mind?</p>
        <a href="/contact" class="hdr-cta mob__cta">
          <span class="hdr-cta__inner">
            <span class="hdr-cta__label">Let's Talk</span>
            <span class="hdr-cta__arrow" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M2 6H10M10 6L6.5 2.5M10 6L6.5 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M2 6H10M10 6L6.5 2.5M10 6L6.5 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </span>
        </a>
      </div>

      <a href={site.products.crm.url} class="mob__login">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 21v-1a7 7 0 0 1 7-7h2a7 7 0 0 1 7 7v1"></path>
        </svg>
        Log in to Storemate CRM
      </a>

      <div class="mob__quick">
        <a href={`mailto:${site.contact.email}`} class="mob__quick-btn" aria-label="Email us">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
        </a>
        <a href={`https://wa.me/${site.contact.whatsapp.replace(/\D/g, "")}`} class="mob__quick-btn" aria-label="WhatsApp us" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 21l1.65-3.8A9 9 0 1 1 7.8 20.3Z"></path>
          </svg>
        </a>
        <a href={site.socials.instagram} class="mob__quick-btn" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
          </svg>
        </a>
        <a href={site.socials.linkedin} class="mob__quick-btn" aria-label="LinkedIn" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  @use "../styles/tokens" as *;

  /* ===== Gradient bar ===== */
  .hdr-gradient-bar {
    height: 3px;
    background: $brand-gradient;
    position: sticky;
    top: 0;
    z-index: 51;
    flex-shrink: 0;
  }

  /* ===== Header ===== */
  .site-header {
    position: sticky;
    top: 3px;                   /* sits below the gradient bar */
    z-index: 50;
    background: rgba($paper, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid $line;
    overflow: visible;          /* allow dropdown to escape */
  }

  .hdr-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: $space-4;
    max-width: $container-max;
    margin: 0 auto;
    padding: 0 $space-5;
    height: 68px;

    @media (min-width: 640px) { padding: 0 $space-6; }
  }

  /* ===== Brand ===== */
  .hdr-brand {
    display: flex;
    align-items: center;
    gap: $space-2;
    flex-shrink: 0;
  }

  .hdr-brand__img {
    border-radius: 8px;
    flex-shrink: 0;
    transition: transform $dur-base $ease-out;
  }

  .hdr-brand:hover .hdr-brand__img {
    transform: rotate(-6deg) scale(1.06);
  }

  .hdr-brand__name {
    font-weight: $fw-black;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: $ink;
    white-space: nowrap;
  }

  /* ===== Desktop nav ===== */
  .hdr-nav {
    display: flex;
    align-items: center;
    gap: $space-1;
  }

  .hdr-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 8px 14px;
    border-radius: $radius-pill;
    color: $ink-soft;
    font-family: inherit;
    font-weight: $fw-medium;
    font-size: 0.9375rem;
    white-space: nowrap;
    border: none;
    background: none;
    cursor: pointer;
    transition: color $dur-fast $ease-out, background $dur-fast $ease-out;

    &:hover { color: $ink; background: $paper-alt; }
    &.is-active { color: $primary; background: $primary-tint; }
  }

  .hdr-caret {
    flex-shrink: 0;
    transition: transform $dur-base $ease-out;
  }

  /* --- Dropdown --- */
  .hdr-nav__dropdown {
    position: relative;

    &.is-open .hdr-nav__link {
      color: $ink;
      background: $paper-alt;

      &.is-active {
        color: $primary;
        background: $primary-tint;
      }
    }
  }

  .hdr-dropdown-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;                    /* anchor left — never overflows right */
    width: 300px;
    background: $paper;
    border: 1px solid $line;
    border-radius: $radius-md;
    box-shadow: 0 12px 40px -8px rgba($ink, 0.14);
    padding: $space-3;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity $dur-base $ease-out, transform $dur-base $ease-out, visibility $dur-base;
    z-index: 60;
    pointer-events: none;
  }

  .hdr-nav__dropdown.is-open .hdr-dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .hdr-nav__dropdown.is-open .hdr-caret {
    transform: rotate(180deg);
  }

  /* --- Dropdown items (shared desktop + mobile) --- */
  .hdr-dd-item {
    display: flex;
    align-items: flex-start;
    gap: $space-3;
    padding: $space-3;
    border-radius: $radius-sm;
    transition: background $dur-fast $ease-out, transform $dur-fast $ease-out;

    &:hover {
      background: $paper-alt;
      transform: translateX(4px);
    }
    &.is-active { background: $paper-alt; }
  }

  .hdr-dd-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    flex-shrink: 0;
    margin-top: 2px;
    position: relative;
    transition: transform $dur-fast $ease-out;

    &::after {
      content: "";
      position: absolute;
      inset: 8px;
      border-radius: 3px;
    }
  }

  .hdr-dd-item:hover .hdr-dd-icon {
    transform: scale(1.08);
  }

  .hdr-dd-icon--crm {
    background: $primary-tint;
    &::after { background: $primary; }
  }

  .hdr-dd-icon--connect {
    background: $secondary-tint;
    &::after { background: $secondary; border-radius: 50%; }
  }

  .hdr-dd-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .hdr-dd-title {
    font-weight: $fw-semibold;
    font-size: 0.9375rem;
    color: $ink;
  }

  .hdr-dd-sub {
    font-size: 0.8125rem;
    color: $muted;
  }

  .hdr-dd-all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: $space-1;
    padding: $space-3;
    font-size: 0.8125rem;
    font-weight: $fw-semibold;
    color: $primary;
    border-top: 1px solid $line;

    span { transition: transform $dur-fast $ease-out; }
    &:hover span { transform: translateX(3px); }
  }

  /* ===== Right side ===== */
  .hdr-right {
    display: flex;
    align-items: center;
    gap: $space-3;
    flex-shrink: 0;
  }

  .hdr-cta-desktop { flex-shrink: 0; }

  /* ===== Burger ===== */
  .hdr-burger {
    display: none;              /* hidden on desktop */
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    border: none;
    background: none;
    cursor: pointer;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }

  .hdr-burger__line {
    display: block;
    width: 22px;
    height: 2px;
    background: $ink;
    border-radius: 2px;
    transition: transform $dur-base $ease-out, opacity $dur-fast $ease-out;
    transform-origin: center;
  }

  .hdr-burger.is-active .hdr-burger__line:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hdr-burger.is-active .hdr-burger__line:nth-child(2) { opacity: 0; }
  .hdr-burger.is-active .hdr-burger__line:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ===== Responsive: show burger, hide desktop nav ===== */
  @media (max-width: 900px) {
    .hdr-nav { display: none; }
    .hdr-cta-desktop { display: none; }
    .hdr-burger { display: flex; }
  }

  /* ========================================================
     DESKTOP — floating pill header + scroll behaviour
     (mobile header above 900px breakpoint stays untouched)
     ======================================================== */
  .hdr-nav__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.8;
    transition: transform $dur-base $ease-out, opacity $dur-fast $ease-out;
  }

  /* Round account button with tooltip */
  .hdr-account {
    position: relative;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: $ink-soft;
    background: rgba($ink, 0.04);
    border: 1px solid rgba($ink, 0.06);
    transition:
      color $dur-fast $ease-out,
      background $dur-base $ease-out,
      border-color $dur-base $ease-out,
      transform $dur-base $ease-out;

    svg { transition: transform $dur-base $ease-out; }

    /* tooltip */
    &::after {
      content: attr(data-tip);
      position: absolute;
      top: calc(100% + 12px);
      left: 50%;
      padding: 6px 10px;
      border-radius: 8px;
      background: $ink;
      color: #fff;
      font-size: 0.75rem;
      font-weight: $fw-semibold;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, -4px);
      transition: opacity $dur-fast $ease-out, transform $dur-base $ease-out;
    }

    &:hover,
    &:focus-visible {
      color: $primary;
      background: $primary-tint;
      border-color: rgba($primary, 0.2);

      svg { transform: translateY(-1px) scale(1.05); }
      &::after { opacity: 1; transform: translate(-50%, 0); }
    }

    @media (max-width: 900px) { display: none; }
  }

  /* Dark CTA with a rotating gradient ring */
  @property --hdr-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .hdr-cta {
    --hdr-angle: 0deg;
    position: relative;
    display: inline-flex;
    padding: 1.5px;
    border-radius: $radius-pill;
    background: conic-gradient(from var(--hdr-angle), $primary, $secondary, #F59E0B, $primary);
    animation: hdr-ring-spin 4s linear infinite;
    isolation: isolate;
    transition: transform $dur-base $ease-out;

    /* soft glow that follows the ring */
    &::before {
      content: "";
      position: absolute;
      inset: 3px;
      z-index: -1;
      border-radius: inherit;
      background: inherit;
      filter: blur(10px);
      opacity: 0.35;
      transition: opacity $dur-base $ease-out;
    }

    &:hover {
      transform: translateY(-1px);
      &::before { opacity: 0.65; }
    }

    @media (max-width: 900px) { display: none; }
  }

  .hdr-cta__inner {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 5px 5px 16px;
    border-radius: inherit;
    background: $ink;
    color: #fff;
    font-weight: $fw-bold;
    font-size: 0.9375rem;
    white-space: nowrap;
    transition: background $dur-base $ease-out;
  }

  .hdr-cta:hover .hdr-cta__inner { background: #2A1D2C; }

  /* "available" pulse */
  .hdr-cta__dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #34D399;

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: inherit;
      animation: hdr-dot-pulse 2s $ease-out infinite;
    }
  }

  /* two arrows: one slides out, the next slides in */
  .hdr-cta__arrow {
    position: relative;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    color: $ink;
    overflow: hidden;

    svg {
      grid-area: 1 / 1;
      transition: transform 0.45s $ease-out;
    }
    svg:last-child { transform: translateX(-200%); }
  }

  .hdr-cta:hover .hdr-cta__arrow {
    svg:first-child { transform: translateX(200%); }
    svg:last-child { transform: translateX(0); }
  }

  @keyframes hdr-ring-spin {
    to { --hdr-angle: 360deg; }
  }

  @keyframes hdr-dot-pulse {
    0% { transform: scale(1); opacity: 0.7; }
    100% { transform: scale(2.8); opacity: 0; }
  }

  @media (min-width: 901px) {
    /* Gradient bar becomes a scroll-progress indicator */
    .hdr-gradient-bar {
      background: transparent;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 52;
      pointer-events: none;

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        background: $brand-gradient;
        transform-origin: left center;
        transform: scaleX(var(--hdr-progress, 0));
      }
    }

    .site-header {
      top: 0;
      padding: 14px $space-5 0;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom: none;
      pointer-events: none;     /* only the pill itself is interactive */
      /* take no layout space so the hero background runs behind the pill */
      margin-bottom: -78px;
      transition: transform 0.5s $ease-out;
      animation: hdr-drop-in 0.8s $ease-out backwards;

      @media (min-width: 640px) { padding: 14px $space-6 0; }
    }

    /* Push the first section's content below the floating pill; a transparent
       border keeps the section's background painting right up to the top. */
    :global(main > section:first-of-type) {
      border-top: 78px solid transparent;
    }

    .hdr-container {
      pointer-events: auto;
      height: 64px;
      max-width: $container-max;
      padding: 0 8px 0 22px;
      background: rgba(#fff, 0.82);
      backdrop-filter: blur(16px) saturate(1.6);
      -webkit-backdrop-filter: blur(16px) saturate(1.6);
      border: 1px solid rgba($line, 0.9);
      border-radius: $radius-pill;
      box-shadow:
        0 1px 2px rgba($ink, 0.04),
        0 8px 30px -10px rgba($ink, 0.12);
      transition:
        max-width 0.6s $ease-out,
        height 0.5s $ease-out,
        box-shadow 0.5s $ease-out,
        background 0.5s $ease-out;
      @media (min-width: 640px) { padding: 0 8px 0 22px; }
    }

    .hdr-brand__name { font-size: 1.15rem; }

    .hdr-nav { gap: 2px; }

    .hdr-nav__link {
      gap: 7px;
      padding: 8px 14px;
      font-size: 0.9375rem;
      color: $ink-soft;

      &:hover {
        color: $ink;
        background: rgba($ink, 0.045);
        .hdr-nav__icon { opacity: 1; transform: translateY(-1px); }
      }
      &.is-active {
        color: $primary;
        background: transparent;
        .hdr-nav__icon { opacity: 1; }
      }
    }

    .hdr-nav__dropdown.is-open .hdr-nav__link {
      color: $ink;
      background: rgba($ink, 0.045);
      &.is-active { color: $primary; background: $primary-tint; }
    }

    /* Dropdown sits below the pill; ::before bridges the hover gap */
    .hdr-dropdown-panel {
      top: calc(100% + 22px);
      left: 50%;
      transform: translate(-50%, 8px) scale(0.98);
      transform-origin: top center;
      border-radius: 20px;
      box-shadow: 0 24px 60px -16px rgba($ink, 0.22);

      &::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: -24px;
        height: 24px;
      }
    }

    .hdr-nav__dropdown.is-open .hdr-dropdown-panel {
      transform: translate(-50%, 0) scale(1);
    }

    /* ---- Scrolled state: tighter, elevated pill ---- */
    .site-header.is-scrolled .hdr-container {
      max-width: 1080px;
      height: 58px;
      background: rgba(#fff, 0.9);
      box-shadow:
        0 1px 2px rgba($ink, 0.05),
        0 16px 40px -14px rgba($ink, 0.22);
    }

  }

  @keyframes hdr-drop-in {
    from { opacity: 0; transform: translateY(-24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ========================================================
     MOBILE — floating pill bar + slide-over sheet
     ======================================================== */
  @media (max-width: 900px) {
    .site-header {
      top: 0;
      padding: 10px 12px 0;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom: none;
      margin-bottom: -68px;
      pointer-events: none;
    }

    .hdr-container {
      pointer-events: auto;
      height: 58px;
      padding: 0 7px 0 14px;
      background: rgba(#fff, 0.86);
      backdrop-filter: blur(16px) saturate(1.6);
      -webkit-backdrop-filter: blur(16px) saturate(1.6);
      border: 1px solid rgba($line, 0.9);
      border-radius: $radius-pill;
      box-shadow:
        0 1px 2px rgba($ink, 0.04),
        0 8px 24px -10px rgba($ink, 0.14);
      transition: box-shadow 0.5s $ease-out, background 0.5s $ease-out;
    }

    .site-header.is-scrolled .hdr-container {
      background: rgba(#fff, 0.94);
      box-shadow:
        0 1px 2px rgba($ink, 0.05),
        0 14px 34px -12px rgba($ink, 0.24);
    }

    .hdr-brand__img { width: 30px; height: 30px; }
    .hdr-brand__name { font-size: 1.1rem; }

    /* burger becomes a dark round button */
    .hdr-burger {
      width: 44px;
      height: 44px;
      gap: 4px;
      border-radius: 50%;
      background: $ink;
      transition: background $dur-base $ease-out, transform $dur-base $ease-out;

      &:active { transform: scale(0.94); }
    }

    .hdr-burger__line {
      width: 16px;
      height: 1.8px;
      background: #fff;

      &:nth-child(2) { width: 10px; margin-left: 6px; transition: width $dur-base $ease-out, margin $dur-base $ease-out, opacity $dur-fast; }
    }

    .hdr-burger.is-active .hdr-burger__line:nth-child(1) { transform: translateY(5.8px) rotate(45deg); }
    .hdr-burger.is-active .hdr-burger__line:nth-child(3) { transform: translateY(-5.8px) rotate(-45deg); }

    /* push first section content below the pill */
    :global(main > section:first-of-type) {
      border-top: 68px solid transparent;
    }
  }

  .mob {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    justify-content: flex-end;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 0.5s;
  }

  .mob.is-open {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  /* backdrop */
  .mob__overlay {
    position: absolute;
    inset: 0;
    background: rgba($ink, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.4s $ease-out;
  }

  .mob.is-open .mob__overlay { opacity: 1; }

  /* sheet — a floating rounded card */
  .mob__sheet {
    position: relative;
    width: calc(100% - 20px);
    max-width: 380px;
    height: calc(100% - 20px);
    margin: 10px;
    background: $paper;
    border-radius: 26px;
    box-shadow: 0 30px 80px -20px rgba($ink, 0.45);
    display: flex;
    flex-direction: column;
    padding: 14px 16px 16px;
    overflow-x: hidden;   /* corner glow + slide-in items must not cause sideways scroll */
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    transform: translateX(calc(100% + 20px));
    transition: transform 0.5s $ease-out;

    /* soft brand glow in the corner */
    &::before {
      content: "";
      position: absolute;
      top: -80px;
      right: -80px;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba($primary, 0.14), rgba($secondary, 0.06) 50%, transparent 70%);
      pointer-events: none;
    }
  }

  .mob.is-open .mob__sheet { transform: translateX(0); }

  /* head */
  .mob__head {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2px 0 14px 4px;
    margin-bottom: 8px;
    border-bottom: 1px dashed $line;
    flex-shrink: 0;
  }

  .mob__x {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid $line;
    background: #fff;
    cursor: pointer;
    color: $ink;
    border-radius: 50%;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
    transition: background $dur-fast $ease-out, transform 0.5s $ease-out;

    &:hover { background: $paper-alt; }
  }

  .mob.is-open .mob__x { transform: rotate(90deg); }

  /* staggered entrance */
  .mob__stagger {
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 0.35s $ease-out, transform 0.5s $ease-out;
  }

  .mob.is-open .mob__stagger {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.12s + var(--i, 0) * 0.055s);
  }

  .mob__label {
    display: block;
    padding: 10px 6px 6px;
    font-size: 0.7rem;
    font-weight: $fw-bold;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: $muted;
  }

  /* links */
  .mob__links {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mob__link {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 8px;
    border: none;
    border-radius: 16px;
    background: none;
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: $fw-semibold;
    color: $ink;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background $dur-fast $ease-out;

    &:active,
    &:hover { background: rgba($ink, 0.04); }

    &.is-active {
      background: $primary-tint;
      color: $primary;

      .mob__link-icon {
        background: $primary;
        border-color: $primary;
        color: #fff;
      }
    }
  }

  .mob__link-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 12px;
    background: #fff;
    border: 1px solid $line;
    color: $ink-soft;
    transition: background $dur-fast $ease-out, color $dur-fast $ease-out;

    svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  }

  .mob__link-label { flex: 1; }

  .mob__link-arrow,
  .mob__link .hdr-caret {
    margin-right: 8px;
    color: $muted;
    flex-shrink: 0;
  }

  .mob__link-arrow {
    transition: transform $dur-base $ease-out, color $dur-fast;
  }

  .mob__link:hover .mob__link-arrow {
    transform: translateX(3px);
    color: $ink;
  }

  .mob__link.is-active .mob__link-arrow,
  .mob__link.is-active .hdr-caret { color: $primary; }

  /* accordion */
  .mob__acc-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s $ease-out;
    overflow: hidden;
  }

  .mob__acc-inner { min-height: 0; }

  .mob__accordion.is-open .mob__acc-body { grid-template-rows: 1fr; }
  .mob__accordion.is-open .hdr-caret { transform: rotate(180deg); }

  .mob__products {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 6px 0 4px;
  }

  .mob__product {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
    border-radius: 16px;
    border: 1px solid $line;
    background: #fff;
    transition: border-color $dur-fast $ease-out, transform $dur-base $ease-out;

    .hdr-dd-icon { margin: 0 0 6px; }
    .hdr-dd-title { font-size: 0.875rem; line-height: 1.25; }
    .hdr-dd-sub { font-size: 0.75rem; line-height: 1.35; }

    &:active { transform: scale(0.97); }
  }

  .mob__product--crm { background: linear-gradient(160deg, $primary-tint, #fff 70%); }
  .mob__product--connect { background: linear-gradient(160deg, $secondary-tint, #fff 70%); }
  .mob__product.is-active { border-color: rgba($primary, 0.4); }

  .mob__acc-body .hdr-dd-all {
    margin-top: 2px;
    padding: 10px 8px;
    border-top: none;
  }

  /* footer */
  .mob__foot {
    position: relative;
    margin-top: auto;
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-shrink: 0;
  }

  .mob__card {
    position: relative;
    overflow: hidden;
    padding: 18px;
    border-radius: 20px;
    background: $ink;
    color: #fff;

    &::before {
      content: "";
      position: absolute;
      right: -40px;
      bottom: -60px;
      width: 180px;
      height: 180px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba($secondary, 0.55), rgba($primary, 0.25) 45%, transparent 70%);
      pointer-events: none;
    }
  }

  .mob__card-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    font-weight: $fw-semibold;
    color: rgba(#fff, 0.7);
  }

  .mob__card-title {
    position: relative;
    margin: 6px 0 14px;
    font-size: 1.2rem;
    font-weight: $fw-bold;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .mob__cta {
    display: flex;
    width: 100%;

    .hdr-cta__inner {
      flex: 1;
      justify-content: space-between;
      padding: 6px 6px 6px 18px;
    }
  }

  .mob__login {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px;
    border-radius: $radius-pill;
    border: 1px solid $line;
    background: #fff;
    font-weight: $fw-semibold;
    font-size: 0.9375rem;
    color: $ink;
    transition: background $dur-fast $ease-out;

    &:active { background: $paper-alt; }
  }

  .mob__quick {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding-top: 2px;
  }

  .mob__quick-btn {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: $ink-soft;
    background: rgba($ink, 0.04);
    transition: color $dur-fast $ease-out, background $dur-fast $ease-out;

    &:hover,
    &:active {
      color: $primary;
      background: $primary-tint;
    }
  }

  /* ===== Reduced motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .mob__sheet,
    .mob__overlay,
    .hdr-dropdown-panel,
    .hdr-burger__line,
    .mob__acc-body,
    .site-header,
    .hdr-container,
    .hdr-cta,
    .hdr-cta__dot::after,
    .hdr-account,
    .mob__stagger,
    .mob__x {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  // ---- Mobile nav ----
  const burger = document.getElementById("burgerBtn");
  const mobNav = document.getElementById("mobNav");
  const mobOverlay = document.getElementById("mobOverlay");
  const mobClose = document.getElementById("mobClose");

  function openMob() {
    mobNav?.classList.add("is-open");
    mobNav?.setAttribute("aria-hidden", "false");
    burger?.classList.add("is-active");
    burger?.setAttribute("aria-expanded", "true");
    document.documentElement.style.overflow = "hidden";
    document.body.style.overflow = "hidden";
  }

  function closeMob() {
    mobNav?.classList.remove("is-open");
    mobNav?.setAttribute("aria-hidden", "true");
    burger?.classList.remove("is-active");
    burger?.setAttribute("aria-expanded", "false");
    document.documentElement.style.overflow = "";
    document.body.style.overflow = "";
    // reset accordion
    const acc = document.getElementById("mobAccTrigger");
    acc?.closest(".mob__accordion")?.classList.remove("is-open");
    acc?.setAttribute("aria-expanded", "false");
  }

  burger?.addEventListener("click", () => {
    burger.getAttribute("aria-expanded") === "true" ? closeMob() : openMob();
  });

  mobClose?.addEventListener("click", closeMob);
  mobOverlay?.addEventListener("click", closeMob);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMob();
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 900) closeMob();
  });

  // auto-close on link click
  mobNav?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMob));

  // ---- Mobile accordion ----
  const accTrigger = document.getElementById("mobAccTrigger");
  accTrigger?.addEventListener("click", () => {
    const isOpen = accTrigger.closest(".mob__accordion")?.classList.toggle("is-open");
    accTrigger.setAttribute("aria-expanded", String(!!isOpen));
  });

  // ---- Desktop dropdown (hover + focus) ----
  const ddWrap = document.getElementById("desktopDropdown");
  const ddTrigger = document.getElementById("desktopDropdownTrigger");

  function openDD() { ddWrap?.classList.add("is-open"); }
  function closeDD() { ddWrap?.classList.remove("is-open"); }

  ddWrap?.addEventListener("mouseenter", openDD);
  ddWrap?.addEventListener("mouseleave", closeDD);
  ddTrigger?.addEventListener("focus", openDD);
  ddWrap?.addEventListener("focusout", (e) => {
    if (!ddWrap.contains((e as FocusEvent).relatedTarget as Node)) closeDD();
  });

  // ---- Scroll behaviour: shrink on scroll + progress bar ----
  // (styles for these states only apply above the 900px breakpoint)
  const header = document.getElementById("siteHeader");
  const progressBar = document.querySelector<HTMLElement>(".hdr-gradient-bar");
  let ticking = false;

  function onScroll() {
    const y = Math.max(window.scrollY, 0);
    const max = document.documentElement.scrollHeight - window.innerHeight;
    progressBar?.style.setProperty("--hdr-progress", String(max > 0 ? Math.min(y / max, 1) : 0));

    header?.classList.toggle("is-scrolled", y > 24);
    ticking = false;
  }

  window.addEventListener("scroll", () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(onScroll);
    }
  }, { passive: true });
  onScroll();

</script>
