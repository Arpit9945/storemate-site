---
/**
 * Centered editorial page hero: kicker, big headline with a hand-drawn
 * underline on the accent phrase, and a lede. Extra content goes in the slot.
 */
interface Props {
  kicker: string;
  title: string;
  accent: string;
  lede?: string;
  id?: string;
}
const { kicker, title, accent, lede, id = 'page-heading' } = Astro.props;
---

<section class="e-hero grid-bg" aria-labelledby={id}>
  <span class="e-hero__wash" aria-hidden="true"></span>
  <div class="container e-hero__inner">
    <p class="e-hero__kicker reveal">
      <span class="e-hero__mark" aria-hidden="true"></span>
      {kicker}
    </p>
    <h1 id={id} class="e-hero__title reveal" style="--reveal-delay: 80ms;">
      {title}
      <span class="e-hero__accent">
        {accent}
        <svg class="e-hero__scribble" viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true">
          <path d="M3 13 C 62 4, 132 3, 190 7 S 268 12, 297 5"></path>
        </svg>
      </span>
    </h1>
    {lede && <p class="e-hero__lede reveal" style="--reveal-delay: 160ms;">{lede}</p>}
    <div class="e-hero__extra reveal" style="--reveal-delay: 240ms;"><slot /></div>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;

  .e-hero {
    position: relative;
    overflow: hidden;
    padding-block: $space-8 $space-7;

    @media (max-width: 640px) { padding-block: $space-6 $space-5; }
  }

  .e-hero__wash {
    position: absolute;
    top: -40%;
    left: 50%;
    width: min(1100px, 120vw);
    aspect-ratio: 2 / 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba($primary, 0.09), rgba($secondary, 0.05) 55%, transparent);
    pointer-events: none;
    z-index: -1;
  }

  .e-hero__inner { text-align: center; }

  .e-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
    font-weight: $fw-semibold;
    color: $ink-soft;
  }

  .e-hero__mark {
    width: 14px;
    height: 14px;
    background: $primary;
    clip-path: polygon(50% 0%, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0% 50%, 39% 39%);
  }

  .e-hero__title {
    margin: $space-4 auto 0;
    max-width: 20ch;
    font-size: clamp(2.4rem, 1.5rem + 3.2vw, 4.25rem);
    font-weight: $fw-black;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .e-hero__accent {
    position: relative;
    display: inline-block;
    color: $primary;
    white-space: nowrap;
  }

  .e-hero__scribble {
    position: absolute;
    left: -2%;
    bottom: -0.16em;
    width: 104%;
    height: 0.28em;
    overflow: visible;

    path {
      fill: none;
      stroke: $primary;
      stroke-width: 5;
      stroke-linecap: round;
      opacity: 0.35;
      stroke-dasharray: 340;
      stroke-dashoffset: 340;
      animation: scribbleDraw 1.1s $ease-out 0.6s forwards;
    }
  }

  @keyframes scribbleDraw { to { stroke-dashoffset: 0; } }

  .e-hero__lede {
    margin: $space-5 auto 0;
    max-width: 58ch;
    font-size: $fs-body-lg;
    color: $ink-soft;
  }

  .e-hero__extra:empty { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .e-hero__scribble path { animation: none; stroke-dashoffset: 0; }
  }
</style>
