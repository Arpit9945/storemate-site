---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CornerMarks from '../components/CornerMarks.astro';
import { site } from '../config/site';

const instagramFeatures = [
  {
    title: 'Comment & DM automation',
    body: 'Set a keyword or reply to every comment on a post or reel — the moment someone asks about a piece, they get an instant reply in their DMs.',
  },
  {
    title: 'Story reply automation',
    body: 'Turn every story reaction into a conversation automatically, without opening Instagram.',
  },
  {
    title: 'Ice-breakers & keyword replies',
    body: 'Quick-reply buttons greet new conversations, and keyword triggers answer common questions instantly — pricing, availability, store hours.',
  },
  {
    title: 'Away messages',
    body: 'Set store hours once, and customers get an automatic reply outside them — so no one is left waiting until morning.',
  },
];

const instagramGroups = [
  {
    title: 'Comment & DM automation',
    items: [
      'Trigger on any comment, or only on specific keywords',
      'Reply via public comment, DM, or both at once',
      'Up to 3 buttons per DM reply — open a link, or send a scripted follow-up',
      'Follow-to-unlock gating — require a follow before the DM content unlocks',
      'Per-rule enable/disable toggle, no need to delete and rebuild',
    ],
  },
  {
    title: 'DM automation tools',
    items: [
      'Ice-breaker quick-reply buttons for new conversations',
      'Keyword-triggered DM replies',
      'Story-reply automation — reply automatically when someone reacts to your story',
      "Welcome message for a customer's very first DM",
      "Default fallback reply for anything that doesn't match a keyword",
      'Away message scheduling, set by day of week and time',
    ],
  },
  {
    title: 'Content, activity & reporting',
    items: [
      'Grid view of all your Reels and posts, pulled directly from Instagram',
      'Filter by all / posts / reels, with adjustable page size',
      'Assign or edit automation rules directly from the grid',
      'Unified activity feed — every automated comment and DM reply in one place',
      'Filter activity by comments or DMs, with summary stats at a glance',
    ],
  },
];

const whatsappFeatures = [
  {
    title: 'Template broadcasts',
    body: 'Send a Meta-approved template to your entire customer list in one broadcast — new arrivals, offers, or updates, out in one send.',
  },
  {
    title: 'Single message sending',
    body: "Send an approved template to one customer at a time, for one-off updates that don't need a full broadcast.",
  },
  {
    title: 'API access per template',
    body: 'Every approved template comes with its own API, so your developer can trigger individual WhatsApp messages directly from your own systems or website.',
  },
  {
    title: 'Full message log',
    body: 'Every message sent is recorded against the customer and the exact date and time — a complete, searchable send history.',
  },
  {
    title: 'Pay-per-use pricing',
    body: "No flat monthly WhatsApp fee — you're billed only for the messages you actually send.",
  },
];

const whatsappGroups = [
  {
    title: 'Broadcast & single messaging',
    items: [
      'Send any Meta-approved template as a broadcast to your full customer list',
      'Send the same template as a single, one-off message to an individual customer',
      'Works for marketing updates, order notifications, or any approved template category',
    ],
  },
  {
    title: 'Developer API access',
    items: [
      'Every approved template is exposed as its own API endpoint',
      'Trigger individual customer messages programmatically from your own website, app, or backend',
      'Useful for order confirmations, delivery updates, or custom workflows outside the Storemate dashboard',
    ],
  },
  {
    title: 'Message records & pricing',
    items: [
      'Every sent message logged against the customer and the exact send time',
      'Searchable history — useful for support, audits, or confirming what a customer was told and when',
      'Pay-per-use billing — pay only for messages sent, with no flat subscription cost for WhatsApp',
    ],
  },
];

const faqs = [
  {
    q: "Is this against Instagram's rules?",
    a: "No. Storemate Connect uses Instagram's official API to send replies, the same access Meta provides to approved partners — no password sharing, no workarounds.",
  },
  {
    q: 'Will my Instagram replies sound robotic?',
    a: 'You write every message yourself, in your own words — Storemate Connect just sends it at the right moment. Nothing is generated automatically unless you choose to.',
  },
  {
    q: "What happens to a question my Instagram automation doesn't cover?",
    a: "You can set a default reply for anything that doesn't match a keyword, so a customer always gets a response, and you can follow up personally later.",
  },
  {
    q: 'Do I need to hand over my Instagram or WhatsApp password to set this up?',
    a: "No. Storemate Connect connects through Instagram's and WhatsApp's official APIs, so your login credentials are never shared with us.",
  },
  {
    q: 'Is WhatsApp automation live, or still coming soon?',
    a: 'It\u2019s live. Broadcasts and single messages using Meta-approved templates, the per-template developer API, and the full message log are all available now.',
  },
  {
    q: 'How does WhatsApp pricing work?',
    a: "WhatsApp messaging on Storemate Connect is pay-per-use — you're billed for the messages you actually send, with no flat monthly fee for the WhatsApp side.",
  },
  {
    q: 'Can my developer send WhatsApp messages from our own website or app?',
    a: "Yes. Every Meta-approved template gets its own API, so your developer can trigger individual WhatsApp messages programmatically from your own systems.",
  },
];

const canonicalUrl = 'https://storematehq.com/storemate-connect';
---

<BaseLayout
  title="Instagram & WhatsApp Marketing Automation Tool | Storemate Connect"
  description="Automate Instagram comments & DMs, plus WhatsApp broadcasts, single messages, and developer API sends on approved templates — pay-per-use, full message history."
  active="connect"
>
  <!-- SoftwareApplication schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Storemate Connect',
      operatingSystem: 'All',
      applicationCategory: 'BusinessApplication',
      description:
        'Storemate Connect auto-replies to Instagram comments, DMs, and story replies, and sends WhatsApp broadcasts and single messages using Meta-approved templates, with a developer API per template and a full message send log.',
      url: canonicalUrl,
      offers: {
        '@type': 'Offer',
        price: '0.00',
        priceCurrency: 'INR',
      },
    })}
  />

  <!-- FAQPage schema: makes the FAQ section eligible for rich snippets in search results -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    })}
  />

  <!-- BreadcrumbList schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://storematehq.com/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://storematehq.com/products' },
        { '@type': 'ListItem', position: 3, name: 'Storemate Connect', item: canonicalUrl },
      ],
    })}
  />

  <link rel="canonical" href={canonicalUrl} slot="head" />

  <nav class="breadcrumb container" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/products">Products</a></li>
      <li aria-current="page">Storemate Connect</li>
    </ol>
  </nav>

  <PageHero
    eyebrow="Storemate Connect"
    tone="connect"
    title="Instagram and WhatsApp, handled from one place."
    lede="Auto-reply to Instagram comments, DMs, and story replies instantly — and send Meta-approved WhatsApp templates as broadcasts, single messages, or straight from your own systems via API."
  >
    <div class="hero__actions">
      <a href={site.products.connect.url} class="btn btn--primary btn--magnetic"><span>Open Storemate Connect</span></a>
      <a href="#instagram" class="btn btn--ghost btn--magnetic"><span>See what's inside</span></a>
    </div>

    <div class="hero__chips">
      <span class="chip">Instagram, official API</span>
      <span class="chip">WhatsApp, pay-per-use</span>
      <span class="chip">Message log included</span>
    </div>
  </PageHero>

  <!-- INSTAGRAM: quick features -->
  <section class="section" id="instagram" aria-labelledby="instagram-heading">
    <div class="container">
      <div class="section-head reveal reveal--left">
        <span class="eyebrow eyebrow--violet">Instagram automation</span>
        <h2 id="instagram-heading" class="h3">Every Instagram interaction, covered.</h2>
      </div>

      <div class="feature-grid">
        {instagramFeatures.map((f, i) => (
          <div
            class="feature-card corner-frame corner-frame--connect reveal reveal--scale tilt-card"
            style={`--reveal-delay: ${i * 70}ms;`}
          >
            <CornerMarks />
            <div class="feature-card__top">
              <span class="facet-item__mark feature-card__mark" aria-hidden="true"></span>
              <span class="badge badge--live">Live</span>
            </div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INSTAGRAM: detailed breakdown -->
  <section class="section section--alt" aria-labelledby="instagram-breakdown-heading">
    <div class="container">
      <div class="section-head reveal reveal--left">
        <span class="eyebrow eyebrow--violet">Instagram, in detail</span>
        <h2 id="instagram-breakdown-heading" class="h3">Every Instagram feature, by category.</h2>
      </div>

      <div class="breakdown-grid">
        {instagramGroups.map((group, i) => (
          <div
            class:list={['breakdown-card', 'corner-frame', 'corner-frame--connect', 'reveal', 'reveal--scale', 'tilt-card']}
            style={`--reveal-delay: ${i * 70}ms;`}
          >
            <CornerMarks />
            <span class="breakdown-card__index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{group.title}</h3>
            <ul class="breakdown-card__list">
              {group.items.map((item) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2.5 7.5L5.5 10.5L11.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHATSAPP: quick features -->
  <section class="section" id="whatsapp" aria-labelledby="whatsapp-heading">
    <div class="container">
      <div class="section-head reveal reveal--left">
        <span class="eyebrow eyebrow--violet">WhatsApp messaging</span>
        <h2 id="whatsapp-heading" class="h3">Meta-approved templates, sent your way.</h2>
      </div>

      <div class="feature-grid">
        {whatsappFeatures.map((f, i) => (
          <div
            class="feature-card corner-frame corner-frame--connect reveal reveal--scale tilt-card"
            style={`--reveal-delay: ${i * 70}ms;`}
          >
            <CornerMarks />
            <div class="feature-card__top">
              <span class="facet-item__mark feature-card__mark" aria-hidden="true"></span>
              <span class="badge badge--live">Live</span>
            </div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHATSAPP: detailed breakdown -->
  <section class="section section--alt" aria-labelledby="whatsapp-breakdown-heading">
    <div class="container">
      <div class="section-head reveal reveal--left">
        <span class="eyebrow eyebrow--violet">WhatsApp, in detail</span>
        <h2 id="whatsapp-breakdown-heading" class="h3">Every WhatsApp feature, by category.</h2>
      </div>

      <div class="breakdown-grid">
        {whatsappGroups.map((group, i) => (
          <div
            class:list={['breakdown-card', 'corner-frame', 'corner-frame--connect', 'reveal', 'reveal--scale', 'tilt-card']}
            style={`--reveal-delay: ${i * 70}ms;`}
          >
            <CornerMarks />
            <span class="breakdown-card__index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{group.title}</h3>
            <ul class="breakdown-card__list">
              {group.items.map((item) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2.5 7.5L5.5 10.5L11.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pair-heading">
    <div class="container">
      <div class="pair corner-frame corner-frame--connect reveal reveal--scale">
        <CornerMarks />
        <div class="pair__text">
          <span class="eyebrow eyebrow--violet">Works better together</span>
          <h2 id="pair-heading" class="h3">Pair it with Storemate CRM</h2>
          <p class="lede">
            Every conversation Connect handles on Instagram or WhatsApp can carry straight into your
            customer's record in Storemate CRM — so your store, your Instagram, and your WhatsApp all
            feel like one system.
          </p>
          <a href="/storemate-crm" class="btn btn--ghost btn--magnetic"><span>Explore Storemate CRM</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container container--narrow">
      <div class="section-head reveal reveal--left">
        <span class="eyebrow eyebrow--violet">Common questions</span>
        <h2 id="faq-heading" class="h3">Frequently asked</h2>
      </div>

      <div class="faq-list">
        {faqs.map((item, i) => (
          <details class="faq-item" style={`--reveal-delay: ${i * 50}ms;`}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA BANNER — structure/styling untouched, copy updated to reflect both channels -->
  <section class="section cta-banner grid-bg grid-bg--dark grid-bg--full">
    <div class="container cta-banner__inner reveal">
      <h2 class="h3">Ready to automate Instagram and WhatsApp?</h2>
      <p class="lede">Connect your account and set up your first automation in minutes.</p>
      <div class="hero__actions">
        <a href={site.products.connect.url} class="btn btn--on-dark">Open Storemate Connect</a>
        <a href="/contact" class="btn" style="border: 1.5px solid rgba(255,255,255,0.35); color: #fff;">Talk to us first</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens' as *;

  // ---- Breadcrumb -----------------------------------------------------------
  .breadcrumb {
    padding-top: $space-5;

    ol {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: $space-2;
      list-style: none;
      font-size: 0.8125rem;
      color: $muted;
    }

    li {
      display: flex;
      align-items: center;
      gap: $space-2;

      &:not(:last-child)::after {
        content: '/';
        color: $line;
      }
    }

    a {
      color: $muted;
      transition: color $dur-base $ease-out;
      &:hover { color: $secondary; }
    }

    li[aria-current='page'] {
      color: $ink-soft;
      font-weight: $fw-semibold;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: $space-4;
    margin-top: $space-6;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: $space-3;
    margin-top: $space-6;
  }

  .chip {
    font-size: 0.8125rem;
    font-weight: $fw-semibold;
    letter-spacing: 0.01em;
    color: $ink-soft;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid $line;
    background: rgba($paper, 0.6);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;

    &::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: $secondary;
      display: inline-block;
    }
  }

  .section-head {
    max-width: 560px;
    margin-bottom: $space-7;

    .h3 { margin-top: $space-3; }
    .lede { margin-top: $space-4; color: $ink-soft; }
  }

  // ---- Feature grid -----------------------------------------------------------
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $space-6;

    @media (max-width: 960px) { grid-template-columns: 1fr 1fr; }
    @media (max-width: 640px) { grid-template-columns: 1fr; }
  }

  .feature-card {
    padding: $space-6;
    transition: box-shadow $dur-base $ease-out;

    &:hover { box-shadow: $shadow-soft; }

    h3 { margin-top: $space-4; font-size: $fs-h6; }
    p { margin-top: $space-3; color: $ink-soft; line-height: 1.55; }
  }

  .feature-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .feature-card__mark { width: 2rem; height: 2rem; }

  // ---- Breakdown grid -----------------------------------------------------------
  .breakdown-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $space-5;

    @media (max-width: 960px) { grid-template-columns: 1fr 1fr; }
    @media (max-width: 640px) { grid-template-columns: 1fr; }
  }

  .breakdown-card {
    padding: $space-6;
    border: 1px solid $line;
    border-radius: $radius-md;
    box-shadow: none;
    transition: box-shadow $dur-base $ease-out;

    &:hover { box-shadow: $shadow-soft; }

    h3 { margin-top: $space-3; font-size: $fs-h6; }
  }

  .breakdown-card__index {
    font-weight: $fw-black;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: $secondary;
  }

  .breakdown-card__list {
    margin-top: $space-4;
    display: flex;
    flex-direction: column;
    gap: $space-3;

    li {
      display: flex;
      align-items: flex-start;
      gap: $space-3;
      color: $ink-soft;
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    svg {
      flex-shrink: 0;
      margin-top: 4px;
      color: $secondary;
    }
  }

  // ---- Pair (cross-sell) section -----------------------------------------------
  .pair {
    display: flex;
    justify-content: center;
    padding: $space-8 $space-7;
    border: 1px solid $line;
    border-radius: $radius-lg;
    background: linear-gradient(180deg, rgba($secondary, 0.05), transparent 60%);
  }

  .pair__text {
    max-width: 640px;
    text-align: center;

    .h3 { margin-top: $space-3; }
    .lede { margin: $space-4 auto $space-6; color: $ink-soft; }
  }

  // ---- FAQ -----------------------------------------------------------------
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: $space-3;
  }

  .faq-item {
    border: 1px solid $line;
    border-radius: $radius-md;
    padding: $space-5;
    transition: border-color $dur-base $ease-out;

    &[open] { border-color: rgba($secondary, 0.35); }

    summary {
      cursor: pointer;
      font-weight: $fw-semibold;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: $space-4;

      &::-webkit-details-marker { display: none; }

      &::after {
        content: '+';
        font-size: 1.25rem;
        color: $secondary;
        flex-shrink: 0;
        transition: transform $dur-base $ease-out;
      }
    }

    &[open] summary::after {
      content: '+';
      transform: rotate(45deg);
    }

    p {
      margin-top: $space-4;
      color: $ink-soft;
      line-height: 1.6;
      animation: faqReveal 0.3s $ease-out;
    }
  }

  @keyframes faqReveal {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  // ---- Tilt cards / magnetic buttons (shared interaction hooks) ------------
  .tilt-card {
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 0.35s $ease-out, box-shadow $dur-base $ease-out;
  }

  .btn--magnetic {
    position: relative;
    display: inline-flex;
    transition: transform 0.25s $ease-out;

    span { display: inline-block; pointer-events: none; }
  }

  // ---- CTA banner (structure/styling untouched) ----------------------------------------------------------
  .cta-banner {
    background: $ink;
    color: $paper;
  }

  .cta-banner__inner {
    text-align: center;
    max-width: 620px;
    margin-inline: auto;
    position: relative;
    z-index: 1;

    .lede { color: rgba($paper, 0.7); margin-inline: auto; margin-top: $space-4; }
    .hero__actions { justify-content: center; }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = window.matchMedia('(hover: hover)').matches;

  if (!prefersReducedMotion && canHover) {
    document.querySelectorAll<HTMLElement>('.btn--magnetic').forEach((btn) => {
      const strength = 12;
      btn.addEventListener('mousemove', (e) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        btn.style.transform = `translate3d(${(x / rect.width) * strength}px, ${(y / rect.height) * strength}px, 0)`;
      });
      btn.addEventListener('mouseleave', () => {
        btn.style.transform = 'translate3d(0, 0, 0)';
      });
    });

    document.querySelectorAll<HTMLElement>('.tilt-card').forEach((card) => {
      const maxTilt = 5;
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width - 0.5;
        const py = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(900px) rotateX(${(-py * maxTilt).toFixed(2)}deg) rotateY(${(px * maxTilt).toFixed(2)}deg) translateY(-4px)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg) translateY(0)';
      });
    });
  }
</script>