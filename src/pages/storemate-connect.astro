---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductHero from '../components/product/ProductHero.astro';
import FeatureCards from '../components/product/FeatureCards.astro';
import FeatureTabs from '../components/product/FeatureTabs.astro';
import PairCard from '../components/product/PairCard.astro';
import ProductFaq from '../components/product/ProductFaq.astro';
import ProductCta from '../components/product/ProductCta.astro';
import { icons } from '../data/icons';
import { site } from '../config/site';

const instagramFeatures = [
  {
    icon: 'message',
    title: 'Comment & DM automation',
    body: 'Set a keyword or reply to every comment on a post or reel — the moment someone asks about a piece, they get an instant reply in their DMs.',
  },
  {
    icon: 'sparkles',
    title: 'Story reply automation',
    body: 'Turn every story reaction into a conversation automatically, without opening Instagram.',
  },
  {
    icon: 'zap',
    title: 'Ice-breakers & keyword replies',
    body: 'Quick-reply buttons greet new conversations, and keyword triggers answer common questions instantly — pricing, availability, store hours.',
  },
  {
    icon: 'moon',
    title: 'Away messages',
    body: 'Set store hours once, and customers get an automatic reply outside them — so no one is left waiting until morning.',
  },
];

const instagramGroups = [
  {
    title: 'Comment & DM automation',
    items: [
      'Trigger on any comment, or only on specific keywords',
      'Reply via public comment, DM, or both at once',
      'Up to 3 buttons per DM reply — open a link, or send a scripted follow-up',
      'Follow-to-unlock gating — require a follow before the DM content unlocks',
      'Per-rule enable/disable toggle, no need to delete and rebuild',
    ],
  },
  {
    title: 'DM automation tools',
    items: [
      'Ice-breaker quick-reply buttons for new conversations',
      'Keyword-triggered DM replies',
      'Story-reply automation — reply automatically when someone reacts to your story',
      "Welcome message for a customer's very first DM",
      "Default fallback reply for anything that doesn't match a keyword",
      'Away message scheduling, set by day of week and time',
    ],
  },
  {
    title: 'Content, activity & reporting',
    items: [
      'Grid view of all your Reels and posts, pulled directly from Instagram',
      'Filter by all / posts / reels, with adjustable page size',
      'Assign or edit automation rules directly from the grid',
      'Unified activity feed — every automated comment and DM reply in one place',
      'Filter activity by comments or DMs, with summary stats at a glance',
    ],
  },
];

const whatsappFeatures = [
  {
    icon: 'send',
    title: 'Template broadcasts',
    body: 'Send a Meta-approved template to your entire customer list in one broadcast — new arrivals, offers, or updates, out in one send.',
  },
  {
    icon: 'user',
    title: 'Single message sending',
    body: "Send an approved template to one customer at a time, for one-off updates that don't need a full broadcast.",
  },
  {
    icon: 'code',
    title: 'API access per template',
    body: 'Every approved template comes with its own API, so your developer can trigger individual WhatsApp messages directly from your own systems or website.',
  },
  {
    icon: 'list',
    title: 'Full message log',
    body: 'Every message sent is recorded against the customer and the exact date and time — a complete, searchable send history.',
  },
  {
    icon: 'wallet',
    title: 'Pay-per-use pricing',
    body: "No flat monthly WhatsApp fee — you're billed only for the messages you actually send.",
  },
];

const whatsappGroups = [
  {
    title: 'Broadcast & single messaging',
    items: [
      'Send any Meta-approved template as a broadcast to your full customer list',
      'Send the same template as a single, one-off message to an individual customer',
      'Works for marketing updates, order notifications, or any approved template category',
    ],
  },
  {
    title: 'Developer API access',
    items: [
      'Every approved template is exposed as its own API endpoint',
      'Trigger individual customer messages programmatically from your own website, app, or backend',
      'Useful for order confirmations, delivery updates, or custom workflows outside the Storemate dashboard',
    ],
  },
  {
    title: 'Message records & pricing',
    items: [
      'Every sent message logged against the customer and the exact send time',
      'Searchable history — useful for support, audits, or confirming what a customer was told and when',
      'Pay-per-use billing — pay only for messages sent, with no flat subscription cost for WhatsApp',
    ],
  },
];

// One tabbed breakdown for both channels
const groupIcons = ['message', 'zap', 'grid', 'send', 'code', 'list'];
const allGroups = [
  ...instagramGroups.map((g) => ({ ...g, channel: 'Instagram' })),
  ...whatsappGroups.map((g) => ({ ...g, channel: 'WhatsApp' })),
].map((g, i) => ({ ...g, icon: groupIcons[i] }));

const faqs = [
  {
    q: "Is this against Instagram's rules?",
    a: "No. Storemate Connect uses Instagram's official API to send replies, the same access Meta provides to approved partners — no password sharing, no workarounds.",
  },
  {
    q: 'Will my Instagram replies sound robotic?',
    a: 'You write every message yourself, in your own words — Storemate Connect just sends it at the right moment. Nothing is generated automatically unless you choose to.',
  },
  {
    q: "What happens to a question my Instagram automation doesn't cover?",
    a: "You can set a default reply for anything that doesn't match a keyword, so a customer always gets a response, and you can follow up personally later.",
  },
  {
    q: 'Do I need to hand over my Instagram or WhatsApp password to set this up?',
    a: "No. Storemate Connect connects through Instagram's and WhatsApp's official APIs, so your login credentials are never shared with us.",
  },
  {
    q: 'Is WhatsApp automation live, or still coming soon?',
    a: 'It’s live. Broadcasts and single messages using Meta-approved templates, the per-template developer API, and the full message log are all available now.',
  },
  {
    q: 'How does WhatsApp pricing work?',
    a: "WhatsApp messaging on Storemate Connect is pay-per-use — you're billed for the messages you actually send, with no flat monthly fee for the WhatsApp side.",
  },
  {
    q: 'Can my developer send WhatsApp messages from our own website or app?',
    a: "Yes. Every Meta-approved template gets its own API, so your developer can trigger individual WhatsApp messages programmatically from your own systems.",
  },
];

const canonicalUrl = new URL('/storemate-connect', site.url).toString();
---

<BaseLayout
  title="Instagram & WhatsApp Marketing Automation Tool | Storemate Connect"
  description="Automate Instagram comments & DMs, plus WhatsApp broadcasts, single messages, and developer API sends on approved templates — pay-per-use, full message history."
  active="connect"
>
  <!-- SoftwareApplication schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Storemate Connect',
      operatingSystem: 'All',
      applicationCategory: 'BusinessApplication',
      description:
        'Storemate Connect auto-replies to Instagram comments, DMs, and story replies, and sends WhatsApp broadcasts and single messages using Meta-approved templates, with a developer API per template and a full message send log.',
      url: canonicalUrl,
      offers: {
        '@type': 'Offer',
        price: '0.00',
        priceCurrency: 'INR',
      },
    })}
  />

  <!-- FAQPage schema: makes the FAQ section eligible for rich snippets in search results -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    })}
  />

  <!-- BreadcrumbList schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site.url).toString() },
        { '@type': 'ListItem', position: 2, name: 'Products', item: new URL('/products', site.url).toString() },
        { '@type': 'ListItem', position: 3, name: 'Storemate Connect', item: canonicalUrl },
      ],
    })}
  />

  <ProductHero
    tone="connect"
    name="Storemate Connect"
    badge="Instagram + WhatsApp live"
    title="Instagram and WhatsApp,"
    accent="handled from one place."
    lede="Auto-reply to Instagram comments, DMs, and story replies instantly — and send Meta-approved WhatsApp templates as broadcasts, single messages, or straight from your own systems via API."
    primary={{ label: 'Open Storemate Connect', href: site.products.connect.url }}
    secondary={{ label: "See what's inside", href: '#instagram' }}
    checks={['Instagram, official API', 'WhatsApp, pay-per-use', 'Message log included']}
  >
    <div slot="visual" class="cx-visual" aria-hidden="true">
      <span class="cx-visual__ring cx-visual__ring--one"></span>
      <span class="cx-visual__ring cx-visual__ring--two"></span>
      <img class="cx-visual__phone" src="/images/home/connect-phone.svg" alt="" width="340" height="690" fetchpriority="high" />

      <div class="cx-card cx-card--keyword">
        <span class="cx-card__icon cx-card__icon--violet"><svg viewBox="0 0 24 24" set:html={icons.zap}></svg></span>
        <span><strong>Keyword: “price”</strong><small>Reply sent to DMs in 2 sec</small></span>
      </div>

      <div class="cx-card cx-card--story">
        <span class="cx-card__icon cx-card__icon--rose"><svg viewBox="0 0 24 24" set:html={icons.sparkles}></svg></span>
        <span><strong>Story reaction</strong><small>Turned into a conversation</small></span>
      </div>

      <div class="cx-card cx-card--wa">
        <span class="cx-card__icon cx-card__icon--green"><svg viewBox="0 0 24 24" set:html={icons.send}></svg></span>
        <span><strong>WhatsApp broadcast sent</strong><small>“New arrivals” template</small></span>
      </div>
    </div>
  </ProductHero>

  <FeatureCards
    tone="connect"
    id="instagram"
    eyebrow="Instagram automation"
    title="Every Instagram interaction, covered."
    intro="Comments, DMs and story replies answered the moment they arrive — in your words, through Instagram's official API."
    items={instagramFeatures}
    badge="Live"
  />

  <FeatureCards
    tone="connect"
    id="whatsapp"
    eyebrow="WhatsApp messaging"
    title="Meta-approved templates, sent your way."
    intro="Broadcast to your whole list, message one customer, or trigger sends from your own systems — and only pay for what you send."
    items={whatsappFeatures}
    badge="Live"
    dark
  />

  <FeatureTabs
    tone="connect"
    id="breakdown"
    eyebrow="In detail"
    title="Every feature, by category."
    lede="A closer look at everything Storemate Connect does on Instagram and WhatsApp."
    groups={allGroups}
  />

  <PairCard
    tone="crm"
    name="Storemate CRM"
    title="Pair it with Storemate CRM"
    text="Every conversation Connect handles on Instagram or WhatsApp can carry straight into your customer's record in Storemate CRM — so your store, your Instagram, and your WhatsApp all feel like one system."
    href="/storemate-crm"
    image={{ src: '/images/home/crm-dashboard.svg', width: 960, height: 620, kind: 'screen' }}
    points={['Inventory by weight & purity', 'GST-ready billing', 'Full customer history in one view']}
  />

  <ProductFaq tone="connect" name="Storemate Connect" faqs={faqs} />

  <ProductCta
    tone="connect"
    title="Ready to automate Instagram and WhatsApp?"
    text="Connect your account and set up your first automation in minutes."
    primary={{ label: 'Open Storemate Connect', href: site.products.connect.url }}
    secondary={{ label: 'Talk to us first', href: '/contact' }}
  />
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens' as *;

  .cx-visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1.02;
    max-width: 560px;
    margin-inline: auto;
  }

  .cx-visual__ring {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed rgba($secondary, 0.3);
    animation: cxTurn 40s linear infinite;
  }

  .cx-visual__ring--one {
    inset: 4%;
    background: radial-gradient(circle, rgba($secondary, 0.14), rgba($primary, 0.06) 45%, transparent 70%);
  }

  .cx-visual__ring--two {
    inset: 18%;
    border-color: rgba($primary, 0.28);
    animation-direction: reverse;
    animation-duration: 30s;
  }

  .cx-visual__phone {
    position: relative;
    width: 50%;
    height: auto;
    filter: drop-shadow(0 40px 50px rgba($ink, 0.3));
    animation: cxFloat 8s ease-in-out infinite;
  }

  .cx-card {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    border-radius: 16px;
    background: rgba(#fff, 0.94);
    border: 1px solid $line;
    box-shadow: 0 18px 40px -16px rgba($ink, 0.28);
    white-space: nowrap;
    animation: cxBob 6s ease-in-out infinite;

    strong { display: block; font-size: 0.8125rem; color: $ink; }
    small { display: block; font-size: 0.72rem; color: $muted; }

    @media (max-width: 640px) {
      padding: 7px 10px 7px 7px;
      strong { font-size: 0.72rem; }
      small { display: none; }
    }
  }

  .cx-card--keyword { top: 16%; left: 0; }
  .cx-card--story { top: 48%; right: 0; animation-delay: -2s; }
  .cx-card--wa { bottom: 10%; left: 4%; animation-delay: -4s; }

  .cx-card__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 10px;
    color: #fff;

    svg {
      width: 17px;
      height: 17px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    @media (max-width: 640px) { width: 28px; height: 28px; }
  }

  .cx-card__icon--violet { background: linear-gradient(135deg, #9B5CF6, $secondary); }
  .cx-card__icon--rose { background: linear-gradient(135deg, #F45C7C, $primary); }
  .cx-card__icon--green { background: linear-gradient(135deg, #34D399, #1FA855); }

  @keyframes cxTurn { to { transform: rotate(360deg); } }

  @keyframes cxFloat {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-14px) rotate(0deg); }
  }

  @keyframes cxBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cx-visual__ring,
    .cx-visual__phone,
    .cx-card { animation: none; }
  }
</style>
