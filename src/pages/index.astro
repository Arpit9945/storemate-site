---
import BaseLayout from '../layouts/BaseLayout.astro';
import CornerMarks from '../components/CornerMarks.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Software that feels like yours"
  description="StoreMate is the studio behind StoreMate CRM and StoreMate Connect — purpose-built products and custom software services for businesses that refuse to settle for generic."
  active="home"
>
  <!-- HERO -->
  <section class="hero grid-bg">
    <div class="hero__ambient" aria-hidden="true">
      <span class="hero__glow hero__glow--rose"></span>
      <span class="hero__glow hero__glow--violet"></span>
      <span class="hero__glow hero__glow--peach"></span>
      <span class="hero__orbit hero__orbit--one"></span>
      <span class="hero__orbit hero__orbit--two"></span>
    </div>
    <div class="hero__particles" aria-hidden="true">
      <span class="particle particle--1"></span>
      <span class="particle particle--2"></span>
      <span class="particle particle--3"></span>
      <span class="particle particle--4"></span>
      <span class="particle particle--5"></span>
      <span class="particle particle--6"></span>
    </div>
    <div class="container hero__inner">
      <span class="eyebrow reveal reveal--left" style="--reveal-delay: 80ms;">Software studio · India</span>
      <h1 class="h1 hero__title reveal reveal--left" style="--reveal-delay: 160ms;">
        We build software that <span class="gradient-text">feels like yours.</span>
      </h1>
      <p class="lede hero__lede reveal reveal--left" style="--reveal-delay: 240ms;">
        Your business isn't generic — your software shouldn't be either.
        From ready-to-use products to fully custom builds, StoreMate crafts
        tools that fit the way you actually work.
      </p>
      <div class="hero__actions reveal reveal--left" style="--reveal-delay: 320ms;">
        <a href="/products" class="btn btn--primary">Explore products</a>
        <a href="/services" class="btn btn--ghost">Explore services</a>
      </div>
    </div>
  </section>

  <!-- TWO PORTIONS: PRODUCTS / SERVICES -->
  <section class="section portions" aria-labelledby="portions-heading">
    <div class="container">
      <div class="section-head reveal reveal--left">
        <span class="eyebrow">How we work</span>
        <h2 id="portions-heading" class="h3">Two ways to work with StoreMate.</h2>
      </div>

      <div class="portions__grid">
        <a href="/products" class="portion-card corner-frame reveal reveal--scale" style="--reveal-delay: 90ms;">
          <CornerMarks />
          <span class="portion-card__index">01</span>
          <h3 class="h4">Products</h3>
          <p>
            Ready-made software you can start using today — StoreMate CRM for running your store,
            StoreMate Connect for automating Instagram and WhatsApp.
          </p>
          <span class="portion-card__link">View our products &rarr;</span>
        </a>

        <a href="/services" class="portion-card corner-frame corner-frame--connect reveal reveal--scale" style="--reveal-delay: 180ms;">
          <CornerMarks />
          <span class="portion-card__index">02</span>
          <h3 class="h4">Services</h3>
          <p>
            Need something specific to your business? We build custom web apps, integrations,
            and automation — scoped and built around your requirements.
          </p>
          <span class="portion-card__link portion-card__link--violet">View our services &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PRODUCTS PREVIEW -->
  <section class="section section--alt" aria-labelledby="products-heading">
    <div class="container">
      <div class="section-head reveal reveal--left">
        <span class="eyebrow">The suite</span>
        <h2 id="products-heading" class="h3">Two products. One connected way of working.</h2>
      </div>

      <div class="products__grid">
        <article class="product-card product-card--crm corner-frame reveal reveal--scale" style="--reveal-delay: 90ms;">
          <CornerMarks />
          <span class="badge badge--live">Live</span>
          <h3 class="h4">StoreMate CRM</h3>
          <p class="product-card__desc">
            Run your jewellery business from one place — inventory, customer records, orders and
            billing, without spreadsheets or guesswork.
          </p>
          <ul class="facet-list">
            <li class="facet-item">
              <span class="facet-item__mark" aria-hidden="true"></span>
              <span class="facet-item__body"><strong>Inventory that makes sense</strong>Track stock by weight, purity, and design — the way jewellery is actually sold.</span>
            </li>
            <li class="facet-item">
              <span class="facet-item__mark" aria-hidden="true"></span>
              <span class="facet-item__body"><strong>Customer history in one view</strong>Every purchase, order, and repair — searchable in seconds.</span>
            </li>
            <li class="facet-item">
              <span class="facet-item__mark" aria-hidden="true"></span>
              <span class="facet-item__body"><strong>Billing that's ready for GST</strong>Generate compliant invoices without a separate tool.</span>
            </li>
          </ul>
          <a href="/storemate-crm" class="btn btn--primary">Explore StoreMate CRM</a>
        </article>

        <article class="product-card product-card--connect corner-frame corner-frame--connect reveal reveal--scale" style="--reveal-delay: 180ms;">
          <CornerMarks />
          <span class="badge badge--live">Instagram live</span>
          <h3 class="h4">StoreMate Connect</h3>
          <p class="product-card__desc">
            Reply to Instagram comments and DMs automatically, so no customer question goes
            unanswered — even after closing time.
          </p>
          <ul class="facet-list">
            <li class="facet-item">
              <span class="facet-item__mark" aria-hidden="true"></span>
              <span class="facet-item__body"><strong>Comment &amp; DM automation</strong>Auto-reply to comments and DMs the moment someone asks about a piece.</span>
            </li>
            <li class="facet-item">
              <span class="facet-item__mark" aria-hidden="true"></span>
              <span class="facet-item__body"><strong>Story reply automation</strong>Turn story reactions into conversations without lifting a finger.</span>
            </li>
            <li class="facet-item">
              <span class="facet-item__mark" aria-hidden="true"></span>
              <span class="facet-item__body"><strong>WhatsApp broadcast <span class="badge badge--soon">Coming soon</span></strong>Send updates and offers straight to your customers' WhatsApp.</span>
            </li>
          </ul>
          <a href="/storemate-connect" class="btn btn--primary">Explore StoreMate Connect</a>
        </article>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="section why" aria-labelledby="why-heading">
    <div class="container">
      <div class="section-head reveal reveal--left">
        <span class="eyebrow">Why StoreMate</span>
        <h2 id="why-heading" class="h3">Built for jewellery businesses, not adapted for them.</h2>
      </div>

      <div class="why__grid">
        <div class="why__item reveal reveal--scale" style="--reveal-delay: 80ms;">
          <span class="facet-item__mark why__mark" aria-hidden="true"></span>
          <h3>Made for one industry</h3>
          <p>Every screen, field, and report is designed around how jewellery is bought, sold, and tracked — not bent from generic retail software.</p>
        </div>
        <div class="why__item reveal reveal--scale" style="--reveal-delay: 160ms;">
          <span class="facet-item__mark why__mark" aria-hidden="true"></span>
          <h3>One connected suite</h3>
          <p>CRM and Connect share the same customer and order data, so your store and your Instagram never feel like two separate systems.</p>
        </div>
        <div class="why__item reveal reveal--scale" style="--reveal-delay: 240ms;">
          <span class="facet-item__mark why__mark" aria-hidden="true"></span>
          <h3>Backed by a services team</h3>
          <p>Need something our products don't cover yet? The same team that builds StoreMate can build it for you, scoped to your business.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="section cta-banner grid-bg grid-bg--dark grid-bg--full">
    <div class="container cta-banner__inner reveal reveal--scale">
      <h2 class="h3">Ready to see StoreMate in action?</h2>
      <p class="lede">Pick a product to try today, or tell us what you need built.</p>
      <div class="hero__actions">
        <a href={site.products.crm.url} class="btn btn--on-dark">Open StoreMate CRM</a>
        <a href="/services" class="btn" style="border: 1.5px solid rgba(255,255,255,0.35); color: #fff;">Talk about a custom build</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens' as *;

  .hero {
    position: relative;
    overflow: hidden;
    padding-block: $space-9 $space-8;
    min-height: min(680px, calc(100svh - 72px));
    display: grid;
    align-items: center;

    @media (max-width: 640px) {
      min-height: 0;
      padding-block: $space-7 $space-6;
    }
  }

  // ---- Animated hero atmosphere --------------------------------------------
  // Transform-only movement keeps the visual light on the GPU while the
  // content remains on its own readable layer.
  .hero.grid-bg::before {
    animation: gridDrift 30s linear infinite;
    will-change: transform;
  }

  .hero__ambient,
  .hero__particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    display: block;
    width: clamp(17rem, 32vw, 32rem);
    aspect-ratio: 1;
    border-radius: 50%;
    opacity: 0.5;
    filter: blur(12px);
    will-change: transform;
  }

  .hero__glow--rose {
    top: -28%;
    right: -7%;
    background: radial-gradient(circle, rgba($primary, 0.28) 0%, rgba($primary, 0.09) 42%, transparent 70%);
    animation: glowFloatRose 16s ease-in-out infinite alternate;
  }

  .hero__glow--violet {
    bottom: -52%;
    left: 33%;
    background: radial-gradient(circle, rgba($secondary, 0.22) 0%, rgba($secondary, 0.08) 45%, transparent 70%);
    animation: glowFloatViolet 19s ease-in-out infinite alternate;
  }

  .hero__glow--peach {
    top: 28%;
    left: -15%;
    width: clamp(13rem, 24vw, 24rem);
    background: radial-gradient(circle, rgba(#F4AB79, 0.18) 0%, transparent 68%);
    animation: glowFloatPeach 14s ease-in-out infinite alternate;
  }

  .hero__orbit {
    position: absolute;
    display: block;
    border: 1px solid rgba($secondary, 0.15);
    border-radius: 50%;
    will-change: transform;
  }

  .hero__orbit--one {
    width: clamp(19rem, 38vw, 38rem);
    aspect-ratio: 1;
    top: -23rem;
    right: -10rem;
    border-color: rgba($primary, 0.16);
    animation: orbitTurn 28s linear infinite;
  }

  .hero__orbit--two {
    width: clamp(14rem, 26vw, 25rem);
    aspect-ratio: 1;
    right: 12%;
    bottom: -18rem;
    border-style: dashed;
    animation: orbitTurn 22s linear infinite reverse;
  }

  .particle {
    position: absolute;
    border-radius: 50%;
    opacity: 0;
    box-shadow: 0 0 0 5px rgba($paper, 0.28), 0 0 20px currentColor;
    animation: particleFloat 12s infinite ease-in-out;
    will-change: transform, opacity;
  }

  .particle--1 {
    width: 6px; height: 6px;
    background: $primary;
    top: 20%; left: 10%;
    animation-delay: 0s;
  }
  .particle--2 {
    width: 4px; height: 4px;
    background: $secondary;
    top: 60%; left: 80%;
    animation-delay: 2s;
  }
  .particle--3 {
    width: 8px; height: 8px;
    background: rgba($primary, 0.4);
    top: 40%; left: 55%;
    animation-delay: 4s;
  }
  .particle--4 {
    width: 5px; height: 5px;
    background: rgba($secondary, 0.5);
    top: 75%; left: 25%;
    animation-delay: 6s;
  }
  .particle--5 {
    width: 3px; height: 3px;
    background: $primary;
    top: 15%; left: 70%;
    animation-delay: 8s;
  }
  .particle--6 {
    width: 7px; height: 7px;
    background: rgba($secondary, 0.3);
    top: 50%; left: 40%;
    animation-delay: 10s;
  }

  @keyframes particleFloat {
    0%   { opacity: 0; transform: translateY(0) scale(0.5); }
    15%  { opacity: 0.6; }
    50%  { opacity: 0.3; transform: translateY(-40px) scale(1); }
    85%  { opacity: 0.6; }
    100% { opacity: 0; transform: translateY(-80px) scale(0.5); }
  }

  @keyframes gridDrift {
    to { transform: translate3d(56px, 56px, 0); }
  }

  @keyframes glowFloatRose {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-11%, 14%, 0) scale(1.12); }
  }

  @keyframes glowFloatViolet {
    from { transform: translate3d(0, 0, 0) scale(0.92); }
    to { transform: translate3d(14%, -16%, 0) scale(1.12); }
  }

  @keyframes glowFloatPeach {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(22%, -18%, 0) scale(1.15); }
  }

  @keyframes orbitTurn {
    to { transform: rotate(360deg); }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .hero__title { margin-top: $space-4; }
  .hero__lede { margin-top: $space-5; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: $space-4;
    margin-top: $space-6;

    @media (max-width: 480px) {
      gap: $space-3;

      .btn {
        width: 100%;
      }
    }
  }

  .section-head {
    max-width: 560px;
    margin-bottom: $space-7;

    .h3 { margin-top: $space-3; }
  }

  // ---- Portions (Products / Services) -------------------------------------
  .portions__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: $space-6;

    @media (max-width: 780px) { grid-template-columns: 1fr; }
  }

  .portion-card {
    display: block;
    border: 1px solid $line;
    border-radius: $radius-lg;
    padding: $space-8 $space-7;
    transition: transform $dur-base $ease-out, box-shadow $dur-base $ease-out;

    &:hover {
      transform: translateY(-4px);
      box-shadow: $shadow-soft;
    }

    h3 { margin-top: $space-4; }
    p { margin-top: $space-4; color: $ink-soft; max-width: 42ch; }
  }

  .portion-card__index {
    font-family: $font-body;
    font-weight: $fw-black;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: $muted;
  }

  .portion-card__link {
    display: inline-block;
    margin-top: $space-6;
    font-weight: $fw-semibold;
    color: $primary;
  }

  .portion-card__link--violet { color: $secondary; }

  // ---- Products ---------------------------------------------------------
  .products__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: $space-6;

    @media (max-width: 860px) {
      grid-template-columns: 1fr;
    }
  }

  .product-card {
    background: $paper;
    border-radius: $radius-lg;
    padding: $space-7;
    display: flex;
    flex-direction: column;
    gap: $space-5;
    border: 1px solid $line;

    .product-card__desc { color: $ink-soft; }
  }

  .product-card .badge--live { align-self: flex-start; }

  // ---- Why grid -----------------------------------------------------------
  .why__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $space-6;

    @media (max-width: 860px) {
      grid-template-columns: 1fr;
    }
  }

  .why__item {
    h3 {
      margin-top: $space-4;
      font-size: $fs-h6;
    }

    p {
      margin-top: $space-3;
      color: $ink-soft;
    }
  }

  .why__mark {
    width: 2rem;
    height: 2rem;
  }

  // ---- CTA banner ----------------------------------------------------------
  .cta-banner {
    background: $ink;
    color: $paper;
  }

  .cta-banner__inner {
    text-align: center;
    max-width: 620px;
    margin-inline: auto;
    position: relative;
    z-index: 1;

    .lede {
      color: rgba($paper, 0.7);
      margin-inline: auto;
      margin-top: $space-4;
    }

    .hero__actions {
      justify-content: center;
      margin-top: $space-6;
    }
  }

  @media (max-width: 640px) {
    .hero__glow--rose {
      top: -16%;
      right: -45%;
      opacity: 0.42;
    }

    .hero__glow--violet {
      bottom: -35%;
      left: 8%;
    }

    .hero__glow--peach,
    .hero__orbit--two,
    .particle--3,
    .particle--4 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero.grid-bg::before,
    .hero__glow,
    .hero__orbit,
    .particle {
      animation: none !important;
    }
  }
</style>
