    /* ── realistic fire (canvas, additive particles + smoke + sparks) ── */
    var W = 300, H = 280;
    var glow = document.getElementById("glow");
    var NS = 14, sprites = [], smokeSpr;
    var ramp = [[255, 252, 225], [255, 226, 110], [255, 160, 30], [245, 92, 12], [175, 30, 14]];
    function rampCol(i) {
      var f = (i / (NS - 1)) * (ramp.length - 1), a = Math.floor(f), b = Math.min(a + 1, ramp.length - 1), t = f - a;
      return ramp[a].map(function (v, k) { return Math.round(v + (ramp[b][k] - v) * t); });
    }
    function makeSprite(c, a1, a2) {
      var s = document.createElement("canvas"); s.width = s.height = 64;
      var x = s.getContext("2d"), g = x.createRadialGradient(32, 32, 0, 32, 32, 32);
      g.addColorStop(0, "rgba(" + c + "," + a1 + ")");
      g.addColorStop(0.45, "rgba(" + c + "," + a2 + ")");
      g.addColorStop(1, "rgba(" + c + ",0)");
      x.fillStyle = g; x.fillRect(0, 0, 64, 64);
      return s;
    }
    for (var si = 0; si < NS; si++) sprites.push(makeSprite(rampCol(si), 1, 0.5));
    smokeSpr = makeSprite([205, 195, 195], 0.5, 0.25);

    function fit() {
      var dpr = Math.min(window.devicePixelRatio || 1, 2), w = cv.clientWidth || 300;
      cv.width = Math.round(w * dpr);
      cv.height = Math.round((w * H / W) * dpr);
      if (fc) { var gd = Math.min(dpr, 1.5); fc.width = Math.round(w * gd); fc.height = Math.round((w * H / W) * gd); }
    }
    fit();
    window.addEventListener("resize", fit);

    // ── WebGL flame shader (realistic, noise-driven). Fail ho to particle fire fallback chalta hai ──
    var fc = document.getElementById("flame"), gl = null, glOk = false, U = {};
    var FRAG = [
      "#ifdef GL_FRAGMENT_PRECISION_HIGH",
      "precision highp float;",
