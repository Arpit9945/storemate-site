    function gnum(n) { return String(n).replace(/\d/g, function (d) { return GUJ.charAt(d); }); }

    // ?name=Rameshbhai  →  "સ્નેહી શ્રી ____" me naam bhar do
    try {
      var n = new URLSearchParams(location.search).get("name");
