<script is:inline>
    (function () {
        var body = document.body;
        var cover = document.getElementById("cover");
        var btn = document.getElementById("openBtn");
        var havan = document.getElementById("havan");
        var cv = document.getElementById("embers");
        var ctx = cv.getContext("2d");
        var reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        // ?name=Rameshbhai  →  "સ્નેહી શ્રી ____" me naam bhar do
        try {
            var n = new URLSearchParams(location.search).get("name");
            if (n) {
                document
                    .querySelectorAll("[data-guest]")
                    .forEach(function (el) {
                        el.textContent = n.trim().slice(0, 40);
                    });
            }
        } catch (e) {}

        /* ── realistic fire (canvas, additive particles + smoke + sparks) ── */
        var W = 300,
            H = 280;
        var glow = document.getElementById("glow");
        var NS = 14,
            sprites = [],
            smokeSpr;
        var ramp = [
            [255, 252, 225],
            [255, 226, 110],
            [255, 160, 30],
            [245, 92, 12],
            [175, 30, 14],
        ];
        function rampCol(i) {
            var f = (i / (NS - 1)) * (ramp.length - 1),
                a = Math.floor(f),
                b = Math.min(a + 1, ramp.length - 1),
                t = f - a;
            return ramp[a].map(function (v, k) {
                return Math.round(v + (ramp[b][k] - v) * t);
            });
        }
        function makeSprite(c, a1, a2) {
            var s = document.createElement("canvas");
            s.width = s.height = 64;
            var x = s.getContext("2d"),
                g = x.createRadialGradient(32, 32, 0, 32, 32, 32);
            g.addColorStop(0, "rgba(" + c + "," + a1 + ")");
            g.addColorStop(0.45, "rgba(" + c + "," + a2 + ")");
            g.addColorStop(1, "rgba(" + c + ",0)");
            x.fillStyle = g;
            x.fillRect(0, 0, 64, 64);
            return s;
        }
        for (var si = 0; si < NS; si++)
            sprites.push(makeSprite(rampCol(si), 1, 0.5));
        smokeSpr = makeSprite([205, 195, 195], 0.5, 0.25);

        function fit() {
            var dpr = Math.min(window.devicePixelRatio || 1, 2),
                w = cv.clientWidth || 300;
            cv.width = Math.round(w * dpr);
            cv.height = Math.round(((w * H) / W) * dpr);
        }
        fit();
        window.addEventListener("resize", fit);

        var fp = [],
            sp = [],
            sm = [];
        var running = false,
            visible = true,
            last = 0,
            litAt = 0,
            flareUntil = 0,
            clock = 0;
        var aF = 0,
            aS = 0,
            aM = 0;

        function spawnFire() {
            var u = (Math.random() + Math.random() + Math.random()) / 1.5 - 1; // bell-shaped: -1..1
            fp.push({
                x: 150 + u * 36,
                y: 165,
                vy: -(60 + Math.random() * 55),
                life: 0,
                max: 0.75 + Math.random() * 0.75,
                r: 12 + Math.random() * 11,
                ph: Math.random() * 6.28,
            });
        }
        function spawnSpark(burst) {
            sp.push({
                x: 150 + (Math.random() - 0.5) * 50,
                y: 150 + Math.random() * 10,
                vx: (Math.random() - 0.5) * (burst ? 60 : 20),
                vy: -(burst
                    ? 60 + Math.random() * 90
                    : 30 + Math.random() * 60),
                r: 0.6 + Math.random() * 1.5,
                life: 0,
                max: 1.4 + Math.random() * 1.8,
                ph: Math.random() * 6.28,
            });
        }
        function spawnSmoke() {
            sm.push({
                x: 150 + (Math.random() - 0.5) * 24,
                y: 105 + Math.random() * 10,
                life: 0,
                max: 3 + Math.random() * 2,
                r: 12 + Math.random() * 8,
            });
        }
        function sparkBurst() {
            for (var i = 0; i < 40; i++) spawnSpark(true);
        }

        function step(dt) {
            clock += dt;
            var now = performance.now();
            var pw = Math.min(1, Math.max(0, (now - litAt) / 2600));
            pw = pw * pw * (3 - 2 * pw);
            var boost = now < flareUntil ? 1 : 0;
            aF += dt * 120 * pw * (1 + boost * 1.7);
            while (aF >= 1) {
                spawnFire();
                aF -= 1;
            }
            aS += dt * 14 * pw;
            while (aS >= 1) {
                spawnSpark(false);
                aS -= 1;
            }
            aM += dt * 5 * pw;
            while (aM >= 1) {
                spawnSmoke();
                aM -= 1;
            }
            var wind = Math.sin(clock * 1.3) * 7 + Math.sin(clock * 3.3) * 3;
            var i, p, k;
            for (i = fp.length - 1; i >= 0; i--) {
                p = fp[i];
                p.life += dt;
                if (p.life >= p.max) {
                    fp.splice(i, 1);
                    continue;
                }
                k = p.life / p.max;
                p.x +=
                    (150 - p.x) * dt * (1.4 + k * 2.6) +
                    (Math.sin(p.life * 9 + p.ph) * 16 + wind * k * 2.5) * dt;
                p.y += p.vy * dt * (boost ? 1.25 : 1);
            }
            for (i = sp.length - 1; i >= 0; i--) {
                p = sp[i];
                p.life += dt;
                if (p.life >= p.max) {
                    sp.splice(i, 1);
                    continue;
                }
                p.x += (p.vx + Math.sin(p.life * 4 + p.ph) * 14 + wind) * dt;
                p.y += p.vy * dt;
                p.vy *= 0.994;
            }
            for (i = sm.length - 1; i >= 0; i--) {
                p = sm[i];
                p.life += dt;
                if (p.life >= p.max) {
                    sm.splice(i, 1);
                    continue;
                }
                p.y -= 16 * dt;
                p.x += (wind * 1.4 + Math.sin(p.life * 2) * 6) * dt;
            }
            return { pw: pw, boost: boost };
        }
        function draw(st) {
            var sc = cv.width / W,
                i,
                p,
                k,
                size;
            ctx.setTransform(sc, 0, 0, sc, 0, 0);
            ctx.clearRect(0, 0, W, H);
            ctx.globalCompositeOperation = "source-over";
            for (i = 0; i < sm.length; i++) {
                p = sm[i];
                k = p.life / p.max;
                size = p.r * (1 + k * 1.8);
                ctx.globalAlpha = Math.sin(k * 3.14) * 0.11 * st.pw;
                ctx.drawImage(
                    smokeSpr,
                    p.x - size,
                    p.y - size,
                    size * 2,
                    size * 2,
                );
            }
            ctx.globalCompositeOperation = "lighter";
            for (i = 0; i < fp.length; i++) {
                p = fp[i];
                k = p.life / p.max;
                var hot =
                    0.1 +
                    k * 0.85 +
                    Math.min(1, Math.abs(p.x - 150) / 70) * 0.3;
                size = p.r * (1 - k * 0.75) * (0.7 + 0.3 * st.pw);
                ctx.globalAlpha = Math.pow(1 - k, 1.1) * 0.62;
                ctx.drawImage(
                    sprites[Math.min(NS - 1, Math.floor(hot * NS))],
                    p.x - size,
                    p.y - size,
                    size * 2,
                    size * 2,
                );
            }
            for (i = 0; i < sp.length; i++) {
                p = sp[i];
                k = 1 - p.life / p.max;
                ctx.globalAlpha = k;
                ctx.fillStyle =
                    "rgb(255," +
                    Math.round(120 + 110 * k) +
                    "," +
                    Math.round(40 * k) +
                    ")";
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.r * (0.5 + k * 0.7), 0, 6.283);
                ctx.fill();
            }
            ctx.globalAlpha = 1;
            var flick =
                0.9 + 0.07 * Math.sin(clock * 11) + 0.05 * Math.sin(clock * 27);
            glow.style.opacity = (
                (0.35 + 0.6 * st.pw) *
                flick *
                (1 + st.boost * 0.25)
            ).toFixed(3);
        }
        function frame(t) {
            if (!running) return;
            var dt = Math.min((t - last) / 1000 || 0.016, 0.05);
            last = t;
            if (visible) draw(step(dt));
            requestAnimationFrame(frame);
        }
        function startEmbers() {
            litAt = performance.now() - (reduce ? 5000 : 0);
            if (reduce) {
                // motion kam: ek still jalti aag
                var st;
                for (var j = 0; j < 90; j++) st = step(1 / 30);
                draw(st);
                return;
            }
            if (running) return;
            running = true;
            last = performance.now();
            requestAnimationFrame(frame);
        }
        if ("IntersectionObserver" in window) {
            new IntersectionObserver(function (e) {
                visible = e[0].isIntersecting;
            }).observe(havan);
        }

        /* ── havan tap: ghee ahuti ── */
        function ahuti() {
            havan.classList.remove("flare");
            void havan.offsetWidth;
            havan.classList.add("flare");
            flareUntil = performance.now() + 900;
            if (!reduce) sparkBurst();
            var s = document.createElement("span");
            s.className = "swaha";
            s.textContent = "સ્વાહા";
            s.addEventListener("animationend", function () {
                s.remove();
            });
            havan.appendChild(s);
        }
        havan.addEventListener("click", ahuti);
        havan.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                ahuti();
            }
        });

        /* ── background music ── */
        var bgm = document.getElementById("bgm");
        var fileOk = !!bgm;
        if (!bgm) bgm = new Audio();
        var mBtn = document.getElementById("musicBtn");
        var wantMusic = true,
            started = false,
            synth = null,
            fadeIv = null;
        try {
            if (localStorage.getItem("mandavoMusic") === "off")
                wantMusic = false;
        } catch (e) {}
        bgm.addEventListener("error", function () {
            fileOk = false;
            if (started && wantMusic) startSynth();
        });

        function updateBtn() {
            mBtn.classList.toggle("off", !wantMusic);
            mBtn.setAttribute("aria-pressed", wantMusic ? "true" : "false");
            mBtn.setAttribute(
                "aria-label",
                wantMusic ? "સંગીત બંધ કરો" : "સંગીત ચાલુ કરો",
            );
        }
        function fadeIn(to, ms) {
            clearInterval(fadeIv);
            var step = to / (ms / 100);
            fadeIv = setInterval(function () {
                bgm.volume = Math.min(to, bgm.volume + step);
                if (bgm.volume >= to) clearInterval(fadeIv);
            }, 100);
        }
        function playFile() {
            bgm.volume = 0;
            var p = bgm.play();
            if (p && p.then) {
                p.then(function () {
                    fadeIn(0.6, 3000);
                }).catch(function () {
                    startSynth();
                });
            } else {
                fadeIn(0.6, 3000);
            }
        }
        // Original aarti-style instrumental (Web Audio): tanpura + harmonium + dholak (keherwa) + manjira + ghanti
        function startSynth() {
            if (synth || !wantMusic) return;
            var AC = window.AudioContext || window.webkitAudioContext;
            if (!AC) return;
            var c = new AC();
            var master = c.createGain();
            master.gain.value = 0;
            var comp = c.createDynamicsCompressor();
            master.connect(comp);
            comp.connect(c.destination);
            master.gain.linearRampToValueAtTime(0.85, c.currentTime + 3);

            // reverb (mandir ki goonj)
            var len = Math.floor(c.sampleRate * 2.4),
                ir = c.createBuffer(2, len, c.sampleRate);
            for (var ch = 0; ch < 2; ch++) {
                var d = ir.getChannelData(ch);
                for (var i = 0; i < len; i++)
                    d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 2.6);
            }
            var verb = c.createConvolver();
            verb.buffer = ir;
            var wet = c.createGain();
            wet.gain.value = 0.32;
            verb.connect(wet);
            wet.connect(master);
            var bus = c.createGain();
            bus.connect(master);
            bus.connect(verb);

            var noise = c.createBuffer(1, c.sampleRate, c.sampleRate),
                nd = noise.getChannelData(0);
            for (var n = 0; n < nd.length; n++) nd[n] = Math.random() * 2 - 1;

            function env(g, t, a, peak, d) {
                g.gain.setValueAtTime(0.0001, t);
                g.gain.exponentialRampToValueAtTime(peak, t + a);
                g.gain.exponentialRampToValueAtTime(0.0001, t + a + d);
            }
            function tone(type, f, t, peak, a, d, dest) {
                var o = c.createOscillator();
                o.type = type;
                o.frequency.value = f;
                var g = c.createGain();
                env(g, t, a, peak, d);
                o.connect(g);
                g.connect(dest || bus);
                o.start(t);
                o.stop(t + a + d + 0.05);
            }
            function bass(t, v) {
                var o = c.createOscillator();
                o.frequency.setValueAtTime(150, t);
                o.frequency.exponentialRampToValueAtTime(62, t + 0.22);
                var g = c.createGain();
                env(g, t, 0.005, v, 0.35);
                o.connect(g);
                g.connect(bus);
                o.start(t);
                o.stop(t + 0.45);
            }
            function tap(t, f, v, dur) {
                var src = c.createBufferSource();
                src.buffer = noise;
                var bp = c.createBiquadFilter();
                bp.type = "bandpass";
                bp.frequency.value = f * 4;
                bp.Q.value = 1.2;
                var g = c.createGain();
                env(g, t, 0.002, v * 0.8, dur);
                src.connect(bp);
                bp.connect(g);
                g.connect(bus);
                src.start(t, Math.random() * 0.5);
                src.stop(t + dur + 0.05);
                tone("triangle", f, t, v * 0.6, 0.002, dur * 0.8);
            }
            function shaker(t, v) {
                var src = c.createBufferSource();
                src.buffer = noise;
                var hp = c.createBiquadFilter();
                hp.type = "highpass";
                hp.frequency.value = 6500;
                var g = c.createGain();
                env(g, t, 0.003, v, 0.05);
                src.connect(hp);
                hp.connect(g);
                g.connect(bus);
                src.start(t, Math.random() * 0.5);
                src.stop(t + 0.1);
            }
            function manjira(t, v) {
                tone("sine", 3150, t, v, 0.001, 0.5);
                tone("sine", 4180, t, v * 0.7, 0.001, 0.38);
                tone("sine", 5300, t, v * 0.45, 0.001, 0.25);
            }
            function ghanti(t, v) {
                [880, 1318.5, 1760, 2637].forEach(function (f, i) {
                    tone("sine", f, t, v / (i + 1), 0.005, 3.2 - i * 0.5);
                });
            }
            function harmonium(t, f, durS) {
                var lp = c.createBiquadFilter();
                lp.type = "lowpass";
                lp.frequency.value = 2200;
                var g = c.createGain();
                g.gain.setValueAtTime(0.0001, t);
                g.gain.linearRampToValueAtTime(0.06, t + 0.04);
                g.gain.setValueAtTime(0.055, t + durS * 0.85);
                g.gain.linearRampToValueAtTime(0.0001, t + durS + 0.12);
                [
                    [f, -5, "sawtooth"],
                    [f, 5, "sawtooth"],
                    [f / 2, 0, "triangle"],
                ].forEach(function (x) {
                    var o = c.createOscillator();
                    o.type = x[2];
                    o.frequency.value = x[0];
                    o.detune.value = x[1];
                    o.connect(lp);
                    o.start(t);
                    o.stop(t + durS + 0.2);
                });
                lp.connect(g);
                g.connect(bus);
            }
            function tanpura(t, f) {
                var lp = c.createBiquadFilter();
                lp.type = "lowpass";
                lp.frequency.value = 1100;
                var g = c.createGain();
                env(g, t, 0.015, 0.06, 3.2);
                var o = c.createOscillator();
                o.type = "sawtooth";
                o.frequency.value = f;
                o.connect(lp);
                lp.connect(g);
                g.connect(bus);
                o.start(t);
                o.stop(t + 3.3);
                tone("triangle", f * 2, t, 0.025, 0.015, 2.4);
            }

            var SA = 146.83; // D3
            var BEAT = 0.54; // ~110 bpm
            var A = [
                [4, 0, 1],
                [7, 1, 1],
                [9, 2, 1.5],
                [7, 3.5, 0.5],
                [4, 4, 1],
                [2, 5, 1],
                [0, 6, 2],
                [4, 8, 1],
                [7, 9, 1],
                [9, 10, 1],
                [12, 11, 1],
                [9, 12, 1],
                [7, 13, 1],
                [4, 14, 2],
            ];
            var B = [
                [9, 0, 1],
                [12, 1, 1],
                [14, 2, 1],
                [12, 3, 1],
                [9, 4, 1],
                [7, 5, 1],
                [4, 6, 2],
                [7, 8, 1],
                [4, 9, 1],
                [2, 10, 1],
                [4, 11, 1],
                [2, 12, 1],
                [0, 13, 1],
                [0, 14, 2],
            ];
            var mel = {};
            A.concat(
                B.map(function (x) {
                    return [x[0], x[1] + 16, x[2]];
                }),
            ).forEach(function (x) {
                var key = Math.round(x[1] * 2);
                (mel[key] = mel[key] || []).push(x);
            });
            var tanP = [SA * 0.75, SA, SA, SA / 2];

            function playStep(s, t) {
                var half = s % 2,
                    beat = s >> 1,
                    m = beat % 8,
                    key = (beat % 32) * 2 + half;
                if (!half) {
                    // dholak: keherwa (Dha Ge Na Ti Na Ka Dhi Na)
                    if (m === 0) {
                        bass(t, 0.55);
                        tap(t, 330, 0.35, 0.12);
                    } else if (m === 1) bass(t, 0.3);
                    else if (m === 2 || m === 4 || m === 7)
                        tap(t, 300, 0.4, 0.1);
                    else if (m === 3) tap(t, 420, 0.22, 0.07);
                    else if (m === 5) {
                        bass(t, 0.22);
                        tap(t, 520, 0.18, 0.05);
                    } else if (m === 6) {
                        bass(t, 0.5);
                        tap(t, 330, 0.35, 0.12);
                    }
                    if (m === 0 || m === 4) manjira(t, m === 0 ? 0.05 : 0.035);
                    if (m === 0 && beat % 16 === 0) ghanti(t, 0.07);
                    if (m % 2 === 0) tanpura(t, tanP[(m / 2) % 4]);
                } else {
                    shaker(t, 0.02);
                }
                (mel[key] || []).forEach(function (x) {
                    harmonium(
                        t,
                        SA * 2 * Math.pow(2, x[0] / 12),
                        x[2] * BEAT * 0.95,
                    );
                });
            }

            var step = 0,
                next = c.currentTime + 0.25;
            function schedule() {
                while (next < c.currentTime + 0.35) {
                    playStep(step, next);
                    next += BEAT / 2;
                    step++;
                }
            }
            schedule();
            synth = { c: c, iv: setInterval(schedule, 100) };
        }
        function startMusic() {
            // cover tap (user gesture) me call hota hai, isliye autoplay allowed
            started = true;
            mBtn.hidden = false;
            updateBtn();
            if (!wantMusic) return;
            if (fileOk) playFile();
            else startSynth();
        }
        function pauseAll() {
            bgm.pause();
            if (synth) synth.c.suspend();
        }
        function resumeAll() {
            if (!started || !wantMusic) return;
            if (synth) synth.c.resume();
            else if (fileOk) playFile();
            else startSynth();
        }
        mBtn.addEventListener("click", function () {
            wantMusic = !wantMusic;
            try {
                localStorage.setItem("mandavoMusic", wantMusic ? "on" : "off");
            } catch (e) {}
            updateBtn();
            if (wantMusic) resumeAll();
            else pauseAll();
        });
        document.addEventListener("visibilitychange", function () {
            if (document.hidden) pauseAll();
            else resumeAll();
        });

        /* ── cover open ── */
        function openCover() {
            if (cover.classList.contains("open")) return;
            cover.classList.add("open");
            body.classList.add("opened");
            window.scrollTo(0, 0);
            setTimeout(function () {
                body.classList.remove("locked");
            }, 1100);
            setTimeout(function () {
                cover.style.display = "none";
            }, 2300);
            setTimeout(startEmbers, 800);
            startMusic();
        }
        btn.addEventListener("click", openCover);
    })();
</script>
