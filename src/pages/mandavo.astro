      function tap(t, f, v, dur) {
        var src = c.createBufferSource(); src.buffer = noise;
        var bp = c.createBiquadFilter(); bp.type = "bandpass"; bp.frequency.value = f * 4; bp.Q.value = 1.2;
        var g = c.createGain(); env(g, t, 0.002, v * 0.8, dur);
        src.connect(bp); bp.connect(g); g.connect(bus); src.start(t, Math.random() * 0.5); src.stop(t + dur + 0.05);
        tone("triangle", f, t, v * 0.6, 0.002, dur * 0.8);
      }
      function shaker(t, v) {
        var src = c.createBufferSource(); src.buffer = noise;
        var hp = c.createBiquadFilter(); hp.type = "highpass"; hp.frequency.value = 6500;
        var g = c.createGain(); env(g, t, 0.003, v, 0.05);
        src.connect(hp); hp.connect(g); g.connect(bus); src.start(t, Math.random() * 0.5); src.stop(t + 0.1);
      }
      function manjira(t, v) {
        tone("sine", 3150, t, v, 0.001, 0.5); tone("sine", 4180, t, v * 0.7, 0.001, 0.38); tone("sine", 5300, t, v * 0.45, 0.001, 0.25);
      }
      function ghanti(t, v) {
        [880, 1318.5, 1760, 2637].forEach(function (f, i) { tone("sine", f, t, v / (i + 1), 0.005, 3.2 - i * 0.5); });
      }
      function harmonium(t, f, durS) {
        var lp = c.createBiquadFilter(); lp.type = "lowpass"; lp.frequency.value = 2200;
        var g = c.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(0.06, t + 0.04);
        g.gain.setValueAtTime(0.055, t + durS * 0.85);
        g.gain.linearRampToValueAtTime(0.0001, t + durS + 0.12);
        [[f, -5, "sawtooth"], [f, 5, "sawtooth"], [f / 2, 0, "triangle"]].forEach(function (x) {
          var o = c.createOscillator(); o.type = x[2]; o.frequency.value = x[0]; o.detune.value = x[1];
          o.connect(lp); o.start(t); o.stop(t + durS + 0.2);
        });
        lp.connect(g); g.connect(bus);
      }
      function tanpura(t, f) {
        var lp = c.createBiquadFilter(); lp.type = "lowpass"; lp.frequency.value = 1100;
        var g = c.createGain(); env(g, t, 0.015, 0.06, 3.2);
        var o = c.createOscillator(); o.type = "sawtooth"; o.frequency.value = f;
        o.connect(lp); lp.connect(g); g.connect(bus); o.start(t); o.stop(t + 3.3);
        tone("triangle", f * 2, t, 0.025, 0.015, 2.4);
      }

      function crackle(t) {
        var src = c.createBufferSource(); src.buffer = noise;
        var hp = c.createBiquadFilter(); hp.type = "highpass"; hp.frequency.value = 2000 + Math.random() * 3500;
        var g = c.createGain(); env(g, t, 0.002, 0.03 + Math.random() * 0.05, 0.02 + Math.random() * 0.03);
        src.connect(hp); hp.connect(g); g.connect(bus); src.start(t, Math.random() * 0.5); src.stop(t + 0.1);
      }
      function shankh(t) {  // shankhnaad
        var o = c.createOscillator(); o.type = "sawtooth";
        o.frequency.setValueAtTime(233, t); o.frequency.linearRampToValueAtTime(240, t + 2.4);
        var lfo = c.createOscillator(), lg = c.createGain(); lfo.frequency.value = 5.5; lg.gain.value = 18;
        lfo.connect(lg); lg.connect(o.detune);
        var lp = c.createBiquadFilter(); lp.type = "lowpass"; lp.frequency.value = 900;
        var g = c.createGain();
        g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(0.09, t + 0.6);
        g.gain.setValueAtTime(0.09, t + 2.0); g.gain.linearRampToValueAtTime(0.0001, t + 3.0);
        o.connect(lp); lp.connect(g); g.connect(bus);
        o.start(t); lfo.start(t); o.stop(t + 3.1); lfo.stop(t + 3.1);
      }

      var SA = 146.83;                 // D3
      var BEAT = 0.54;                 // ~110 bpm
      var A = [[4, 0, 1], [7, 1, 1], [9, 2, 1.5], [7, 3.5, 0.5], [4, 4, 1], [2, 5, 1], [0, 6, 2],
               [4, 8, 1], [7, 9, 1], [9, 10, 1], [12, 11, 1], [9, 12, 1], [7, 13, 1], [4, 14, 2]];
      var B = [[9, 0, 1], [12, 1, 1], [14, 2, 1], [12, 3, 1], [9, 4, 1], [7, 5, 1], [4, 6, 2],
               [7, 8, 1], [4, 9, 1], [2, 10, 1], [4, 11, 1], [2, 12, 1], [0, 13, 1], [0, 14, 2]];
      var mel = {};
      A.concat(B.map(function (x) { return [x[0], x[1] + 16, x[2]]; })).forEach(function (x) {
        var key = Math.round(x[1] * 2); (mel[key] = mel[key] || []).push(x);
      });
      var tanP = [SA * 0.75, SA, SA, SA / 2];

      function playStep(s, t) {
        var half = s % 2, beat = s >> 1, m = beat % 8, key = (beat % 32) * 2 + half;
        if (Math.random() < 0.45) crackle(t + Math.random() * BEAT / 2);
        if (!half) {
          // dholak: keherwa (Dha Ge Na Ti Na Ka Dhi Na)
          if (m === 0) { bass(t, 0.55); tap(t, 330, 0.35, 0.12); }
          else if (m === 1) bass(t, 0.3);
          else if (m === 2 || m === 4 || m === 7) tap(t, 300, 0.4, 0.1);
          else if (m === 3) tap(t, 420, 0.22, 0.07);
          else if (m === 5) { bass(t, 0.22); tap(t, 520, 0.18, 0.05); }
          else if (m === 6) { bass(t, 0.5); tap(t, 330, 0.35, 0.12); }
          if (m === 0 || m === 4) manjira(t, m === 0 ? 0.05 : 0.035);
          if (m === 0 && beat % 16 === 0) ghanti(t, 0.07);
          if (m % 2 === 0) tanpura(t, tanP[(m / 2) % 4]);
        } else {
          shaker(t, 0.02);
        }
        (mel[key] || []).forEach(function (x) {
          harmonium(t, SA * 2 * Math.pow(2, x[0] / 12), x[2] * BEAT * 0.95);
        });
      }

      var step = 0, next = c.currentTime + 2.6;
      shankh(c.currentTime + 0.1);
      function schedule() {
        while (next < c.currentTime + 0.35) { playStep(step, next); next += BEAT / 2; step++; }
      }
      schedule();
      synth = { c: c, iv: setInterval(schedule, 100) };
    }
    function startMusic() {   // cover tap (user gesture) me call hota hai, isliye autoplay allowed
      started = true;
      mBtn.hidden = false;
      updateBtn();
      if (!wantMusic) return;
      if (fileOk) playFile(); else startSynth();
    }
    function pauseAll() { bgm.pause(); if (synth) synth.c.suspend(); }
    function resumeAll() {
      if (!started || !wantMusic) return;
      if (synth) synth.c.resume(); else if (fileOk) playFile(); else startSynth();
    }
    mBtn.addEventListener("click", function () {
      wantMusic = !wantMusic;
      try { localStorage.setItem("mandavoMusic", wantMusic ? "on" : "off"); } catch (e) {}
      updateBtn();
      if (wantMusic) resumeAll(); else pauseAll();
    });
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) pauseAll(); else resumeAll();
    });

    /* ── cover open ── */
    function openCover() {
      if (cover.classList.contains("open")) return;
      cover.classList.add("open");
      body.classList.add("opened");
      window.scrollTo(0, 0);
      setTimeout(function () { body.classList.remove("locked"); }, 1100);
      setTimeout(function () { cover.style.display = "none"; }, 2300);
      setTimeout(startEmbers, 800);
      startMusic();
    }
    btn.addEventListener("click", openCover);
  })();
</script>