---
// ───────────────────────── mandavo.astro ─────────────────────────
// Single-file page: HTML + CSS + JS sab isi file me.
// Mataji ni photo dalni ho to niche ke 2 paths bharo (e.g. "/images/ambaji.jpg" — file public/ folder me rakho)
const ambajiImg = "";
const bahucharImg = "";

// Background music: default me page apna ORIGINAL aarti-style instrumental (tanpura + harmonium + dholak + manjira)
// khud bajata hai — koi file nahi chahiye. Apni mp3 lagani ho to path likho, e.g. "/audio/aarti.mp3" (public/audio/ me rakho).
const bgSong = "";

const pageTitle = "આમંત્રણ પત્રિકા | શ્રી અંબાજીમાં નો નવરંગો માંડવો";
const mapUrl =
    "https://www.google.com/maps/search/?api=1&query=" +
    encodeURIComponent("સોની જ્ઞાતિની વાડી, દાળમીલ રોડ, સુરેન્દ્રનગર");

const events = [
    {
        title: "માંડવો રોપવાનું",
        date: "તા. ૨-૧૨-૨૦૨૬",
        day: "બુધવાર",
        time: "સવારે ૮:૦૦ કલાકે",
    },
    {
        title: "મહા પ્રસાદ",
        date: "તા. ૨-૧૨-૨૦૨૬",
        day: "બુધવાર",
        time: "સાંજે ૭:૩૦ કલાકે",
    },
    {
        title: "માંડવો વધાવવાનું",
        date: "તા. ૩-૧૨-૨૦૨૬",
        day: "ગુરૂવાર",
        time: "સવારે ૭:૩૦ કલાકે",
    },
];

const bhuvaLeft = [
    ["વીરજીબાપુ", "શ્રી વેરાઈ માતાજી"],
    ["જશવંતલાલ", "શ્રી મોમાઈ માતાજી"],
    ["ધીરૂભાઈ", "શ્રી શક્તિ માતાજી"],
    ["મનસુખભાઈ", "શ્રી બ્રહ્માણી માતાજી"],
    ["ચંદુભા ઝાલા", "શ્રી શક્તિ માતાજી"],
    ["જયેન્દ્રસિંહ જાડેજા", "શ્રી મોમાઈ માતાજી"],
];
const bhuvaRight = [
    ["ચકુભાઈ", "શ્રી ચામુંડા માતાજી"],
    ["જામભા", "શ્રી મેલડી માતાજી"],
    ["ઘનશ્યામસિંહ", "શ્રી મોમાઈ માતાજી"],
    ["અશોકભાઈ", "શ્રી મેલડી માતાજી"],
    ["કાળુભાઈ", "શ્રી ચામુંડા માતાજી"],
];

const nimantrak = [
    ["સ્વ. સોની શાંતીલાલ સુંદરજીભાઈ", "સ્વ. ઘેલીબેન શાંતીલાલ"],
    ["સોની નરેન્દ્રકુમાર શાંતીલાલ", "અ.સૌ. ઇલાબેન નરેન્દ્રકુમાર"],
    ["સોની જુગલકુમાર નરેન્દ્રકુમાર", "અ.સૌ. મનીષાબેન જુગલકુમાર"],
    ["સોની અર્પિતકુમાર જુગલકુમાર", "અ.સૌ. અભિજ્ઞા અર્પિતકુમાર"],
];

const flame =
    "M0,0 C-26,-2 -34,-36 -18,-66 C-14,-52 -8,-48 -6,-42 C-8,-70 4,-98 0,-124 C22,-98 36,-56 28,-24 C24,-8 12,0 0,0Z";
---

<!doctype html>
<html lang="gu">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <meta name="theme-color" content="#2e0710" />
        <meta name="robots" content="noindex, nofollow" />
        <title>{pageTitle}</title>
        <meta property="og:title" content={pageTitle} />
        <meta
            property="og:description"
            content="સોની જ્ઞાતિની વાડી, સુરેન્દ્રનગર — તા. ૨ અને ૩ ડિસેમ્બર ૨૦૨૬"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Baloo+Bhai+2:wght@600;700;800&family=Hind+Vadodara:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <noscript>
            <style>
                .cover {
                    display: none !important;
                }
                body.locked {
                    overflow: auto !important;
                }
                .fire {
                    transform: none !important;
                }
            </style>
        </noscript>
    </head>

    <body class="locked">
        <!-- ═════════ COVER (wrapper) : click karo to darwaza khule ═════════ -->
        <div class="cover" id="cover">
            <div class="door door-l"></div>
            <div class="door door-r"></div>
            <p class="cover-top">॥ શ્રી ગણેશાય નમઃ ॥</p>
            <button
                class="seal"
                id="openBtn"
                type="button"
                aria-label="આમંત્રણ ખોલો"
            >
                <span class="seal-om">ૐ</span>
                <span class="seal-t1">આમંત્રણ</span>
                <span class="seal-t2">ખોલવા ટેપ કરો</span>
            </button>
            <p class="cover-bot">॥ જયશ્રી અંબાજી માં ॥</p>
        </div>

        {bgSong && <audio id="bgm" src={bgSong} loop preload="auto" />}
        <button
            class="music"
            id="musicBtn"
            type="button"
            aria-label="સંગીત બંધ કરો"
            aria-pressed="true"
            hidden
        >
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"></path>
                <path
                    class="w"
                    d="M16 8.5a5 5 0 010 7M18.5 6a8.5 8.5 0 010 12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"></path>
                <path
                    class="x"
                    d="M16 9l6 6M22 9l-6 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"></path>
            </svg>
        </button>

        <!-- ═════════ INVITATION ═════════ -->
        <main class="patrika">
            <header class="hero">
                <svg class="toran" width="100%" height="58" aria-hidden="true">
                    <defs>
                        <pattern
                            id="tp"
                            width="50"
                            height="58"
                            patternUnits="userSpaceOnUse"
                        >
                            <path d="M0 0H50V8H0Z" fill="#d9a441"></path>
                            <path d="M4 8H46L25 50Z" fill="#f2a20c"></path>
                            <path d="M12 8H38L25 34Z" fill="#9b1c24"></path>
                            <circle cx="25" cy="53" r="3.6" fill="#ffe9a8"
                            ></circle>
                        </pattern>
                    </defs>
                    <rect width="100%" height="58" fill="url(#tp)"></rect>
                </svg>

                <p class="ganesh">॥ શ્રી ગણેશાય નમઃ ॥</p>

                <div class="matas">
                    <figure class="mata">
                        {
                            ambajiImg && (
                                <img
                                    src={ambajiImg}
                                    alt="શ્રી અંબાજી માતાજી"
                                    loading="lazy"
                                />
                            )
                        }
                        <figcaption>॥ જયશ્રી અંબાજી માં ॥</figcaption>
                    </figure>
                    <figure class="mata">
                        {
                            bahucharImg && (
                                <img
                                    src={bahucharImg}
                                    alt="શ્રી બહુચર માતાજી"
                                    loading="lazy"
                                />
                            )
                        }
                        <figcaption>॥ જયશ્રી બહુચર માં ॥</figcaption>
                    </figure>
                </div>

                <h1 class="title">આમંત્રણ પત્રિકા</h1>

                <!-- Animated havan -->
                <div
                    class="havan"
                    id="havan"
                    role="button"
                    tabindex="0"
                    aria-label="હવનમાં ઘી અર્પણ કરો"
                >
                    <div class="glow" id="glow"></div>
                    <!-- back layer: kund -->
                    <svg viewBox="0 0 300 280" aria-hidden="true">
                        <defs>
                            <linearGradient
                                id="brick"
                                x1="0"
                                y1="0"
                                x2="0"
                                y2="1"
                            >
                                <stop offset="0" stop-color="#c8662b"></stop>
                                <stop offset="1" stop-color="#8a3813"></stop>
                            </linearGradient>
                        </defs>
                        <ellipse
                            cx="150"
                            cy="240"
                            rx="130"
                            ry="12"
                            fill="rgba(0,0,0,.4)"></ellipse>
                        <rect
                            x="42"
                            y="208"
                            width="216"
                            height="28"
                            rx="3"
                            fill="url(#brick)"></rect>
                        <rect
                            x="62"
                            y="184"
                            width="176"
                            height="26"
                            rx="3"
                            fill="url(#brick)"></rect>
                        <rect
                            x="82"
                            y="160"
                            width="136"
                            height="26"
                            rx="3"
                            fill="url(#brick)"></rect>
                        <path
                            d="M42 215H258M62 191H238M82 167H218"
                            stroke="#f2c14e"
                            stroke-width="2"
                            stroke-dasharray="1 7"
                            stroke-linecap="round"
                            fill="none"></path>
                        <ellipse
                            cx="150"
                            cy="161"
                            rx="66"
                            ry="11"
                            fill="#1d0606"></ellipse>
                        <ellipse
                            class="coals"
                            cx="150"
                            cy="162"
                            rx="56"
                            ry="7"
                            fill="#ff6a00"></ellipse>
                        <ellipse
                            class="coals"
                            cx="150"
                            cy="162"
                            rx="34"
                            ry="4"
                            fill="#ffc34d"
                            style="animation-delay:-.7s"></ellipse>
                    </svg>
                    <!-- middle layer: live fire -->
                    <canvas id="embers"></canvas>
                    <!-- front layer: logs, lip, diyas -->
                    <svg viewBox="0 0 300 280" aria-hidden="true">
                        <defs>
                            <linearGradient
                                id="g-mid"
                                x1="0"
                                y1="1"
                                x2="0"
                                y2="0"
                            >
                                <stop offset="0" stop-color="#fff27a"></stop>
                                <stop offset="1" stop-color="#ff9d00"></stop>
                            </linearGradient>
                            <linearGradient
                                id="log"
                                x1="0"
                                y1="0"
                                x2="0"
                                y2="1"
                            >
                                <stop offset="0" stop-color="#7a3d18"></stop>
                                <stop offset="1" stop-color="#34160a"></stop>
                            </linearGradient>
                        </defs>
                        <g transform="translate(150,162)">
                            <g transform="rotate(-9)">
                                <rect
                                    x="-56"
                                    y="-9"
                                    width="112"
                                    height="12"
                                    rx="6"
                                    fill="url(#log)"></rect>
                                <rect
                                    class="coals"
                                    x="-50"
                                    y="-5"
                                    width="100"
                                    height="3"
                                    rx="1.5"
                                    fill="#ff5a00"
                                    opacity=".45"></rect>
                            </g>
                            <g transform="rotate(9)">
                                <rect
                                    x="-56"
                                    y="-9"
                                    width="112"
                                    height="12"
                                    rx="6"
                                    fill="url(#log)"></rect>
                                <rect
                                    class="coals"
                                    x="-50"
                                    y="-5"
                                    width="100"
                                    height="3"
                                    rx="1.5"
                                    fill="#ff5a00"
                                    opacity=".45"
                                    style="animation-delay:-.5s"></rect>
                            </g>
                        </g>
                        <path
                            d="M82 161 Q150 181 218 161 L218 169 Q150 189 82 169Z"
                            fill="#b9541f"></path>
                        <path d="M8 236 Q22 250 36 236Z" fill="#d9a441"></path>
                        <path d="M264 236 Q278 250 292 236Z" fill="#d9a441"
                        ></path>
                        <g transform="translate(22,235) scale(.15)">
                            <path
                                class="fl"
                                d={flame}
                                fill="url(#g-mid)"
                                style="--d:.7s"></path>
                        </g>
                        <g transform="translate(278,235) scale(.15)">
                            <path
                                class="fl"
                                d={flame}
                                fill="url(#g-mid)"
                                style="--d:.8s;animation-delay:-.3s"></path>
                        </g>
                    </svg>
                </div>
            </header>

            <div class="paper">
                <p class="greet">
                    સ્નેહી શ્રી <span class="blank" data-guest></span>
                </p>

                <p class="lead">
                    સહર્ષ ખુશાલી સાથ જણાવવાનું કે શ્રી અંબાજી માતાજીની અસીમ
                    કૃપાથી
                </p>

                <h2 class="ribbon">શ્રી અંબાજીમાં નો નવરંગો માંડવો</h2>

                <p class="lead">
                    <strong>સંવત ૨૦૮૩ કારતક વદ-૯ ને બુધવાર તા. ૨-૧૨-૨૦૨૬</strong
                    >
                    ના શુભ દિને નિર્ધારેલ છે. તો આ શુભ પ્રસંગે માતાજી ના દર્શને તેમજ
                    પ્રસાદ નો લાભ લેવા આપશ્રી
                    <span class="blank inl" data-guest></span> પધારી અમારી શોભામાં
                    અભિવૃદ્ધિ કરશોજી.
                </p>

                <div class="tag"><span>માંગલીક પ્રસંગો</span></div>

                <div class="events">
                    {
                        events.map((e) => (
                            <article class="ev">
                                <h3>{e.title}</h3>
                                <p class="d">{e.date}</p>
                                <p class="w">{e.day}</p>
                                <p class="t">{e.time}</p>
                            </article>
                        ))
                    }
                </div>

                <p class="venue">
                    સોની જ્ઞાતિની વાડી, દાળમીલ રોડ, સુરેન્દ્રનગર.
                </p>
                <p class="center">
                    <a
                        class="btn ghost"
                        href={mapUrl}
                        target="_blank"
                        rel="noopener">નકશામાં જુઓ</a
                    >
                </p>

                <div class="tag"><span>ભુવાશ્રી</span></div>
                <p class="rawal">રાવળદેવ : વિનુભાઈ મુળીવાળા</p>
                <div class="bhuva">
                    <ul>
                        {
                            bhuvaLeft.map(([n, m]) => (
                                <li>
                                    <>
                                        <b>{n}</b>
                                        <span>{m}</span>
                                    </>
                                </li>
                            ))
                        }
                    </ul>
                    <i class="sep" aria-hidden="true"></i>
                    <ul>
                        {
                            bhuvaRight.map(([n, m]) => (
                                <li>
                                    <>
                                        <b>{n}</b>
                                        <span>{m}</span>
                                    </>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="tag"><span>નિમંત્રક</span></div>
                <div class="nim">
                    <p class="devasibhai">સ્વ.  દેવસીભાઈ સુંદરજીભાઈ</p>
                    {
                        nimantrak.map(([a, b]) => (
                            <div class="couple">
                                <p>{a}</p>
                                <p>{b}</p>
                            </div>
                        ))
                    }
                    <p class="kumari">કુ. પ્રગતિ જુગલકુમાર સોની</p>
                </div>

                <address class="addr">
                    ૨, જુની કોટન માર્કેટ, પાણીની ટાંકી પાસે, પ્રતિક એપાર્ટમેન્ટ
                    સામે, સુરેન્દ્રનગર.
                </address>
                <div class="calls">
                    <a class="btn" href="tel:+919427065506"
                        >નરેન્દ્રભાઈ : મો. ૯૪૨૭૦ ૬૫૫૦૬</a
                    >
                    <a class="btn" href="tel:+919909124711"
                        >જુગલભાઈ : મો. ૯૯૦૯૧ ૨૪૭૧૧</a
                    >
                </div>
            </div>
        </main>
    </body>
</html>

<style is:global>
    :root {
        --kum: #9b1c24;
        --maroon: #4a0e17;
        --deep: #2e0710;
        --mari: #f2a20c;
        --gold: #d9a441;
        --cream: #fff6dc;
        --ink: #23296b;
        --pink: #b0245f;
        --disp: "Baloo Bhai 2", "Noto Sans Gujarati", sans-serif;
    }
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }
    html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
    }
    body {
        margin: 0;
        font-family: "Hind Vadodara", "Noto Sans Gujarati", sans-serif;
        font-size: 1.05rem;
        line-height: 1.75;
        color: var(--ink);
        background-color: var(--deep);
        background-image: repeating-conic-gradient(
            from 45deg at 50% 50%,
            rgba(217, 164, 65, 0.07) 0 25%,
            transparent 0 50%
        );
        background-size: 36px 36px;
    }
    body.locked {
        overflow: hidden;
    }
    a {
        color: inherit;
    }
    :focus-visible {
        outline: 3px solid var(--mari);
        outline-offset: 3px;
    }

    /* ───────── COVER ───────── */
    .cover {
        position: fixed;
        inset: 0;
        z-index: 50;
        perspective: 1400px;
        overflow: hidden;
    }
    .cover.open {
        pointer-events: none;
    }
    .door {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 50.2%;
        background:
            radial-gradient(
                circle at var(--cx, 100%) 50%,
                rgba(242, 162, 12, 0.3),
                transparent 40%
            ),
            repeating-linear-gradient(
                45deg,
                rgba(217, 164, 65, 0.1) 0 2px,
                transparent 2px 22px
            ),
            repeating-linear-gradient(
                -45deg,
                rgba(217, 164, 65, 0.1) 0 2px,
                transparent 2px 22px
            ),
            linear-gradient(#5b1020, #34090f);
        box-shadow:
            inset 0 0 0 5px #2e0710,
            inset 0 0 0 7px var(--gold);
        transition: transform 1.7s cubic-bezier(0.65, 0, 0.25, 1);
        backface-visibility: hidden;
    }
    .door-l {
        left: 0;
        transform-origin: left center;
        --cx: 100%;
    }
    .door-r {
        right: 0;
        transform-origin: right center;
        --cx: 0%;
    }
    .door::before {
        content: "";
        position: absolute;
        top: 7vh;
        bottom: 7vh;
        left: 5vw;
        right: 0;
        border: 3px solid var(--gold);
        border-right: 0;
        border-top-left-radius: min(45vw, 60vh);
    }
    .door-r::before {
        left: 0;
        right: 5vw;
        border: 3px solid var(--gold);
        border-left: 0;
        border-top-left-radius: 0;
        border-top-right-radius: min(45vw, 60vh);
    }
    .door::after {
        content: "";
        position: absolute;
        top: calc(7vh + 12px);
        bottom: calc(7vh + 12px);
        left: calc(5vw + 12px);
        right: 0;
        border: 1px solid rgba(255, 233, 168, 0.55);
        border-right: 0;
        border-top-left-radius: calc(min(45vw, 60vh) - 12px);
