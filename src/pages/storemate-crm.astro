---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CornerMarks from '../components/CornerMarks.astro';
import { site } from '../config/site';

const features = [
  {
    title: 'Inventory by weight, purity & design',
    body: "Track every piece the way jewellery actually sells — by gross and net weight, purity (18K/22K/24K, or by hallmark), stone details, and design code. No forcing your stock into a generic 'product' field.",
  },
  {
    title: 'Customer history in one view',
    body: 'Every purchase, order, repair, and exchange tied to a customer — searchable in seconds, so any staff member can pick up where the last conversation left off.',
  },
  {
    title: 'Orders & repairs tracking',
    body: 'Log custom orders and repair jobs with status, expected delivery date, and customer notifications — nothing falls through the cracks.',
  },
  {
    title: 'GST-ready billing',
    body: 'Generate compliant invoices with HSN codes, making charges, and tax breakup built in — no separate billing software needed.',
  },
  {
    title: 'Daily rate updates',
    body: "Update today's gold and silver rates once, and every quote and invoice reflects it automatically.",
  },
  {
    title: 'Staff access, kept simple',
    body: 'Give your team access to exactly what they need — the counter, the workshop, or the full store — without handing over everything.',
  },
];

const featureGroups = [
  {
    title: 'Dashboard & insights',
    items: [
      'Time-range filtered business stats — today, or any custom date range',
      'Live overview of orders, pending payments, and stock at a glance',
      'Order and payment trend charts',
      'Product-wise and payment-wise breakdowns',
    ],
  },
  {
    title: 'Customer management',
    items: [
      'Searchable customer directory',
      'Full purchase, order, and loan history in one profile',
      'Quick customer add during billing — no separate screen needed',
    ],
  },
  {
    title: 'Orders & billing',
    items: [
      'Multi-item order builder — pick from stock or enter manually',
      'Gross/net weight, purity, HUID, and making charges (percentage or flat)',
      'Old jewellery exchange (trade-in) built into the same order',
      'Auto-calculated totals with discount and tax applied per item',
      'Partial or full payment collection against any order',
      'Downloadable, GST-ready PDF invoices',
    ],
  },
  {
    title: 'Inventory & stock',
    items: [
      'Category-based stock organization',
      'Item-level weight, purity, making charge, and photos',
      'Stock stats to see what\u2019s moving and what isn\u2019t',
    ],
  },
  {
    title: 'Loans (Jama / Girvi)',
    items: [
      'Loan creation against pledged jewellery, linked to a customer',
      'Automatic monthly interest calculation from the loan start date',
      'Due-date tracking with overdue flags',
      'Partial repayment collection against interest or principal',
    ],
  },
  {
    title: 'Staff & access',
    items: [
      'Separate owner and staff login',
      'Staff accounts scoped to what they need — counter, workshop, or full access',
    ],
  },
  {
    title: 'Store settings',
    items: [
      'General store profile — name, address, GST details',
      'Offers and promotions management',
      'Multiple invoice bill layout designs to choose from',
    ],
  },
];

const faqs = [
  {
    q: 'Do I need to change how I currently track inventory?',
    a: "No. Storemate CRM is built around how jewellery businesses already track stock — by weight and purity — so the switch feels familiar from day one.",
  },
  {
    q: 'Can I use it on my phone, or only on a computer?',
    a: 'Storemate CRM works on both. Use it at the billing counter on a desktop, or check orders and customer history from your phone while you\u2019re away from the store.',
  },
  {
    q: 'Is my data backed up?',
    a: "Yes. Your inventory, customer records, and billing history are backed up automatically, so nothing is lost if a device is damaged or lost.",
  },
  {
    q: 'Can I try it before paying?',
    a: 'Yes, Storemate CRM offers a free trial period so you can set up your store and see it fit your workflow before committing.',
  },
];
---

<BaseLayout
  title="Jewellery CRM Software & GST Billing App | Storemate CRM"
  description="Best Jewellery CRM software for retail shops. Track inventory by weight & purity, manage customer history, and generate GST-ready invoices easily."
  active="crm"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Storemate CRM",
      "operatingSystem": "All",
      "applicationCategory": "BusinessApplication",
      "description": "Storemate CRM helps jewellery businesses manage inventory by weight and purity, track customer history, and generate GST-ready invoices — all from one place.",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "INR"
      }
    })}
  />
  <PageHero
    eyebrow="Storemate CRM"
    tone="crm"
    title="Run your jewellery business from one place."
    lede="Inventory, customer history, orders, and billing — built around how jewellery is actually bought and sold, not bent from generic retail software."
  >
    <div class="hero__actions">
      <a href={site.products.crm.url} class="btn btn--primary">Open Storemate CRM</a>
      <a href="#features" class="btn btn--ghost">See what's inside</a>
    </div>
  </PageHero>

  <section class="section" id="features" aria-labelledby="features-heading">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">What's inside</span>
        <h2 id="features-heading" class="h3">Everything the counter and the back office need.</h2>
      </div>

      <div class="feature-grid">
        {features.map((f) => (
          <div class="feature-card corner-frame reveal">
            <CornerMarks />
            <span class="facet-item__mark feature-card__mark" aria-hidden="true"></span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="breakdown-heading">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">The full picture</span>
        <h2 id="breakdown-heading" class="h3">Every feature, by category.</h2>
        <p class="lede" style="margin-top: 1rem;">
          A closer look at what's inside Storemate CRM — organized the way you'd actually use it.
        </p>
      </div>

      <div class="breakdown-grid">
        {featureGroups.map((group, i) => (
          <div class="breakdown-card corner-frame reveal">
            <CornerMarks />
            <span class="breakdown-card__index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{group.title}</h3>
            <ul class="breakdown-card__list">
              {group.items.map((item) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2.5 7.5L5.5 10.5L11.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="pair-heading">
    <div class="container pair reveal">
      <div class="pair__text">
        <span class="eyebrow">Works better together</span>
        <h2 id="pair-heading" class="h3">Pair it with Storemate Connect</h2>
        <p class="lede">
          When a customer asks about a piece on Instagram, Storemate Connect can reply instantly —
          and once they walk in, Storemate CRM already has their conversation on record.
        </p>
        <a href="/storemate-connect" class="btn btn--ghost">Explore StoreMate Connect</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container container--narrow">
      <div class="section-head reveal">
        <span class="eyebrow">Common questions</span>
        <h2 id="faq-heading" class="h3">Frequently asked</h2>
      </div>

      <div class="faq-list reveal">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta-banner grid-bg grid-bg--dark grid-bg--full">
    <div class="container cta-banner__inner reveal">
      <h2 class="h3">Ready to bring your store onto Storemate?</h2>
      <p class="lede">Start a free trial — your inventory and billing, organised in an afternoon.</p>
      <div class="hero__actions">
        <a href={site.products.crm.url} class="btn btn--on-dark">Open Storemate CRM</a>
        <a href="/contact" class="btn" style="border: 1.5px solid rgba(255,255,255,0.35); color: #fff;">Talk to us first</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens' as *;

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: $space-4;
    margin-top: $space-6;
  }

  .section-head {
    max-width: 560px;
    margin-bottom: $space-7;
    .h3 { margin-top: $space-3; }
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $space-6;

    @media (max-width: 960px) { grid-template-columns: 1fr 1fr; }
    @media (max-width: 640px) { grid-template-columns: 1fr; }
  }

  .feature-card {
    h3 { margin-top: $space-4; font-size: $fs-h6; }
    p { margin-top: $space-3; color: $ink-soft; }
  }

  .feature-card__mark { width: 2rem; height: 2rem; }

  .breakdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: $space-5;

    @media (max-width: 780px) { grid-template-columns: 1fr; }
  }

  .breakdown-card {
    padding: $space-6;
    border: 1px solid $line;
    border-radius: $radius-md;
    transition: transform $dur-base $ease-out, box-shadow $dur-base $ease-out;

    &:hover { transform: translateY(-3px); box-shadow: $shadow-soft; }

    h3 { margin-top: $space-2; font-size: $fs-h6; }
  }

  .breakdown-card__index {
    font-weight: $fw-black;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: $primary;
  }

  .breakdown-card__list {
    margin-top: $space-4;
    display: flex;
    flex-direction: column;
    gap: $space-3;

    li {
      display: flex;
      align-items: flex-start;
      gap: $space-3;
      color: $ink-soft;
      font-size: 0.9375rem;
      line-height: 1.5;
    }

    svg {
      flex-shrink: 0;
      margin-top: 4px;
      color: $primary;
    }
  }

  .pair {
    display: flex;
    justify-content: center;
  }

  .pair__text {
    max-width: 620px;
    text-align: center;

    .h3 { margin-top: $space-3; }
    .lede { margin: $space-4 auto $space-6; }
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: $space-3;
  }

  .faq-item {
    border: 1px solid $line;
    border-radius: $radius-md;
    padding: $space-5;

    summary {
      cursor: pointer;
      font-weight: $fw-semibold;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;

      &::-webkit-details-marker { display: none; }

      &::after {
        content: '+';
        font-size: 1.25rem;
        color: $primary;
        flex-shrink: 0;
        margin-left: $space-4;
      }
    }

    &[open] summary::after { content: '\2212'; }

    p { margin-top: $space-4; color: $ink-soft; }
  }

  .cta-banner {
    background: $ink;
    color: $paper;
  }

  .cta-banner__inner {
    text-align: center;
    max-width: 620px;
    margin-inline: auto;
    position: relative;
    z-index: 1;

    .lede { color: rgba($paper, 0.7); margin-inline: auto; margin-top: $space-4; }
    .hero__actions { justify-content: center; }
  }
</style>
