---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductHero from "../components/product/ProductHero.astro";
import FeatureCards from "../components/product/FeatureCards.astro";
import FeatureTabs from "../components/product/FeatureTabs.astro";
import PairCard from "../components/product/PairCard.astro";
import ProductFaq from "../components/product/ProductFaq.astro";
import ProductCta from "../components/product/ProductCta.astro";
import { site } from "../config/site";

const features = [
  {
    icon: "scale",
    title: "Inventory by weight, purity & design",
    body: "Track every piece the way jewellery actually sells — by gross and net weight, purity (18K/22K/24K, or by hallmark), stone details, and design code. No forcing your stock into a generic 'product' field.",
  },
  {
    icon: "users",
    title: "Customer history in one view",
    body: "Every purchase, order, repair, and exchange tied to a customer — searchable in seconds, so any staff member can pick up where the last conversation left off.",
  },
  {
    icon: "wrench",
    title: "Orders & repairs tracking",
    body: "Log custom orders and repair jobs with status, expected delivery date, and customer notifications — nothing falls through the cracks.",
  },
  {
    icon: "receipt",
    title: "GST-ready billing",
    body: "Generate compliant invoices with HSN codes, making charges, and tax breakup built in — no separate billing software needed.",
  },
  {
    icon: "trend",
    title: "Daily rate updates",
    body: "Update today's gold and silver rates once, and every quote and invoice reflects it automatically.",
  },
  {
    icon: "shield",
    title: "Staff access, kept simple",
    body: "Give your team access to exactly what they need — the counter, the workshop, or the full store — without handing over everything.",
  },
];

const featureGroups = [
  {
    title: "Dashboard & insights",
    icon: "chart",
    items: [
      "Time-range filtered business stats — today, or any custom date range",
      "Live overview of orders, pending payments, and stock at a glance",
      "Order and payment trend charts",
      "Product-wise and payment-wise breakdowns",
    ],
  },
  {
    title: "Customer management",
    icon: "users",
    items: [
      "Searchable customer directory",
      "Full purchase, order, and loan history in one profile",
      "Quick customer add during billing — no separate screen needed",
    ],
  },
  {
    title: "Orders & billing",
    icon: "receipt",
    items: [
      "Multi-item order builder — pick from stock or enter manually",
      "Gross/net weight, purity, HUID, and making charges (percentage or flat)",
      "Old jewellery exchange (trade-in) built into the same order",
      "Auto-calculated totals with discount and tax applied per item",
      "Partial or full payment collection against any order",
      "Downloadable, GST-ready PDF invoices",
    ],
  },
  {
    title: "Inventory & stock",
    icon: "box",
    items: [
      "Category-based stock organization",
      "Item-level weight, purity, making charge, and photos",
      "Stock stats to see what's moving and what isn't",
    ],
  },
  {
    title: "Loans (Jama / Girvi)",
    icon: "landmark",
    items: [
      "Loan creation against pledged jewellery, linked to a customer",
      "Automatic monthly interest calculation from the loan start date",
      "Due-date tracking with overdue flags",
      "Partial repayment collection against interest or principal",
    ],
  },
  {
    title: "Staff & access",
    icon: "shield",
    items: [
      "Separate owner and staff login",
      "Staff accounts scoped to what they need — counter, workshop, or full access",
    ],
  },
  {
    title: "Store settings",
    icon: "settings",
    items: [
      "General store profile — name, address, GST details",
      "Offers and promotions management",
      "Multiple invoice bill layout designs to choose from",
    ],
  },
];

const faqs = [
  {
    q: "Do I need to change how I currently track inventory?",
    a: "No. Storemate CRM is built around how jewellery businesses already track stock — by weight and purity — so the switch feels familiar from day one.",
  },
  {
    q: "Can I use it on my phone, or only on a computer?",
    a: "Storemate CRM works on both. Use it at the billing counter on a desktop, or check orders and customer history from your phone while you're away from the store.",
  },
  {
    q: "Is my data backed up?",
    a: "Yes. Your inventory, customer records, and billing history are backed up automatically, so nothing is lost if a device is damaged or lost.",
  },
  {
    q: "Can I try it before paying?",
    a: "Yes, Storemate CRM offers a free trial period so you can set up your store and see it fit your workflow before committing.",
  },
  {
    q: "Is Storemate CRM suitable for small jewellery shops, or only large stores?",
    a: "Storemate CRM scales to the business — a single-counter shop can run on it as easily as a store with multiple staff logins and locations.",
  },
];

const canonicalUrl = new URL("/storemate-crm", site.url).toString();
---

<BaseLayout
  title="Jewellery CRM Software & GST Billing App | Storemate CRM"
  description="Jewellery CRM software for retail shops in India. Track inventory by weight & purity, manage customer history, and generate GST-ready invoices — free trial available."
  active="crm"
>
  <!-- SoftwareApplication schema: powers rich results for the product itself -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Storemate CRM",
      operatingSystem: "All",
      applicationCategory: "BusinessApplication",
      description:
        "Storemate CRM helps jewellery businesses manage inventory by weight and purity, track customer history, and generate GST-ready invoices — all from one place.",
      url: canonicalUrl,
      offers: {
        "@type": "Offer",
        price: "0.00",
        priceCurrency: "INR",
      },
    })}
  />

  <!-- FAQPage schema: makes the FAQ section eligible for rich snippets in search results -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
    })}
  />

  <!-- BreadcrumbList schema: reinforces site hierarchy for search engines -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", site.url).toString() },
        { "@type": "ListItem", position: 2, name: "Products", item: new URL("/products", site.url).toString() },
        { "@type": "ListItem", position: 3, name: "Storemate CRM", item: canonicalUrl },
      ],
    })}
  />

  <ProductHero
    tone="crm"
    name="Storemate CRM"
    badge="Live"
    title="Run your jewellery business"
    accent="from one place."
    lede="Inventory, customer history, orders, and billing — built around how jewellery is actually bought and sold, not bent from generic retail software."
    primary={{ label: "Open Storemate CRM", href: site.products.crm.url }}
    secondary={{ label: "See what's inside", href: "#features" }}
    checks={["Free trial", "Works on phone & desktop", "Automatic backups"]}
  >
    <div slot="visual" class="crm-visual" aria-hidden="true">
      <div class="crm-visual__screen">
        <img src="/images/home/crm-dashboard.svg" alt="" width="960" height="620" fetchpriority="high" />
      </div>
      <img class="crm-visual__invoice" src="/images/home/gst-invoice.svg" alt="" width="320" height="300" />
      <div class="crm-visual__chip">
        <span class="crm-visual__chip-icon">
          <svg viewBox="0 0 24 24"><path d="m22 7-8.5 8.5-5-5L2 17" /><path d="M16 7h6v6" /></svg>
        </span>
        <span>
          <strong>Today's rate updated</strong>
          <small>Every quote follows automatically</small>
        </span>
      </div>
    </div>
  </ProductHero>

  <FeatureCards
    tone="crm"
    id="features"
    eyebrow="What's inside"
    title="Everything the counter and the back office need."
    intro="Six building blocks that replace the register, the spreadsheet and the separate billing tool."
    items={features}
  />

  <FeatureTabs
    tone="crm"
    id="breakdown"
    eyebrow="The full picture"
    title="Every feature, by category."
    lede="A closer look at what's inside Storemate CRM — organized the way you'd actually use it."
    groups={featureGroups}
  />

  <PairCard
    tone="connect"
    name="Storemate Connect"
    title="Pair it with Storemate Connect"
    text="When a customer asks about a piece on Instagram, Storemate Connect can reply instantly — and once they walk in, Storemate CRM already has their conversation on record."
    href="/storemate-connect"
    image={{ src: "/images/home/connect-phone.svg", width: 340, height: 690, kind: "phone" }}
    points={["Instant Instagram comment & DM replies", "Story replies turned into conversations", "One customer record across both"]}
  />

  <ProductFaq tone="crm" name="Storemate CRM" faqs={faqs} />

  <ProductCta
    tone="crm"
    title="Ready to bring your store onto Storemate?"
    text="Start a free trial — your inventory and billing, organised in an afternoon."
    primary={{ label: "Open Storemate CRM", href: site.products.crm.url }}
    secondary={{ label: "Talk to us first", href: "/contact" }}
  />
</BaseLayout>

<style lang="scss">
  @use "../styles/tokens" as *;

  .crm-visual {
    position: relative;
    padding: 0 $space-6 $space-8 0;

    @media (max-width: 640px) { padding: 0 $space-4 $space-7 0; }
  }

  .crm-visual__screen {
    position: relative;
    border-radius: 18px;
    box-shadow:
      0 2px 4px rgba($ink, 0.04),
      0 40px 80px -32px rgba($primary-dark, 0.4);
    animation: crmFloat 9s ease-in-out infinite;

    img { width: 100%; height: auto; border-radius: 18px; }

    &::before {
      content: "";
      position: absolute;
      inset: -18px auto auto -18px;
      width: 50%;
      height: 60%;
      border-radius: 24px;
      background: $primary-tint;
      z-index: -1;
    }
  }

  .crm-visual__invoice {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 40%;
    height: auto;
    filter: drop-shadow(0 26px 40px rgba($ink, 0.24));
    animation: crmBob 7s ease-in-out infinite;
  }

  .crm-visual__chip {
    position: absolute;
    left: -4%;
    bottom: 10%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    border-radius: 16px;
    background: rgba(#fff, 0.94);
    border: 1px solid $line;
    box-shadow: 0 18px 40px -16px rgba($ink, 0.28);
    white-space: nowrap;
    animation: crmBob 6s ease-in-out infinite -2s;

    strong { display: block; font-size: 0.8125rem; color: $ink; }
    small { display: block; font-size: 0.72rem; color: $muted; }

    @media (max-width: 640px) {
      left: 0;
      bottom: 4%;
      small { display: none; }
    }
  }

  .crm-visual__chip-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(135deg, #F5B54A, #E2832F);
    color: #fff;

    svg {
      width: 17px;
      height: 17px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  }

  @keyframes crmFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @keyframes crmBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .crm-visual__screen,
    .crm-visual__invoice,
    .crm-visual__chip { animation: none; }
  }
</style>
