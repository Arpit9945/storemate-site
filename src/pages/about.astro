---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CornerMarks from '../components/CornerMarks.astro';

const values = [
  {
    title: 'Built for one industry',
    body: 'We don\u2019t adapt generic retail software for jewellery businesses — every screen is designed around how jewellery is actually bought, sold, and tracked.',
  },
  {
    title: 'One connected suite',
    body: 'Your store and your Instagram shouldn\u2019t feel like two separate systems. Our products share the same customer and order data underneath.',
  },
  {
    title: 'Simple enough for day one',
    body: 'No training manuals, no long onboarding calls. If you can use WhatsApp, you can run Storemate.',
  },
];
---

<BaseLayout
  title="About Storemate | Custom Software Studio & CRM creators"
  description="Meet Storemate, a software studio crafting industry-specific tools like Storemate CRM and Storemate Connect, alongside bespoke custom software."
  active="about"
>
  <PageHero
    eyebrow="About us"
    title="One team, two products — and work we take on beyond them."
    lede="Storemate started with a simple observation: jewellery businesses were being asked to run their stores on tools built for everyone else. So we started building Storemate CRM and Storemate Connect, purpose-built for this industry — and we take on custom software work for other businesses alongside them."
  />

  <section class="section" aria-labelledby="values-heading">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">What we believe</span>
        <h2 id="values-heading" class="h3">How we build</h2>
      </div>

      <div class="values-grid">
        {values.map((v) => (
          <div class="value-card corner-frame reveal">
            <CornerMarks />
            <span class="facet-item__mark value-card__mark" aria-hidden="true"></span>
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="portions-heading">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Two portions, one team</span>
        <h2 id="portions-heading" class="h3">Products and services</h2>
      </div>

      <div class="portions-mini">
        <a href="/products" class="portions-mini__item corner-frame reveal">
          <CornerMarks />
          <span class="portions-mini__index">01</span>
          <h3>Products</h3>
          <p>Storemate CRM and Storemate Connect — ready to use today, built for jewellery businesses.</p>
          <span class="portions-mini__link">View products &rarr;</span>
        </a>
        <a href="/services" class="portions-mini__item corner-frame corner-frame--connect reveal">
          <CornerMarks />
          <span class="portions-mini__index">02</span>
          <h3>Services</h3>
          <p>Custom web apps, integrations, and automation — scoped and built around your business.</p>
          <span class="portions-mini__link portions-mini__link--violet">View services &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section cta-banner grid-bg grid-bg--dark grid-bg--full">
    <div class="container cta-banner__inner reveal">
      <h2 class="h3">Have a question before you get started?</h2>
      <p class="lede">We\u2019re happy to walk you through either product, or scope a custom build.</p>
      <a href="/contact" class="btn btn--on-dark">Contact us</a>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens' as *;

  .section-head {
    max-width: 560px;
    margin-bottom: $space-7;
    .h3 { margin-top: $space-3; }
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $space-6;

    @media (max-width: 860px) { grid-template-columns: 1fr; }
  }

  .value-card {
    padding: $space-6;
    border: 1px solid $line;
    border-radius: $radius-md;
    transition: transform $dur-base $ease-out, box-shadow $dur-base $ease-out;

    &:hover { transform: translateY(-3px); box-shadow: $shadow-soft; }

    h3 { margin-top: $space-4; font-size: $fs-h6; }
    p { margin-top: $space-3; color: $ink-soft; }
  }

  .value-card__mark { width: 2rem; height: 2rem; }

  .portions-mini {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: $space-6;

    @media (max-width: 720px) { grid-template-columns: 1fr; }
  }

  .portions-mini__item {
    display: block;
    background: $paper;
    border-radius: $radius-lg;
    padding: $space-7;
    transition: transform $dur-base $ease-out, box-shadow $dur-base $ease-out;

    &:hover { transform: translateY(-4px); box-shadow: $shadow-soft; }

    h3 { font-size: $fs-h5; margin-top: $space-4; }
    p { margin-top: $space-3; color: $ink-soft; }
  }

  .portions-mini__index {
    font-weight: $fw-black;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: $muted;
  }

  .portions-mini__link {
    display: inline-block;
    margin-top: $space-5;
    font-weight: $fw-semibold;
    color: $primary;
  }

  .portions-mini__link--violet { color: $secondary; }

  .cta-banner { background: $ink; color: $paper; }

  .cta-banner__inner {
    text-align: center;
    max-width: 560px;
    margin-inline: auto;
    position: relative;
    z-index: 1;
    .lede { color: rgba($paper, 0.7); margin: $space-4 auto $space-6; }
  }
</style>
