---
import LegalLayout from '../layouts/LegalLayout.astro';
import { site } from '../config/site';
---

<LegalLayout
  title="Terms & Conditions"
  description="The terms that govern your use of Storemate CRM and Storemate Connect."
  updated="10 July 2026"
>
  <h2>1. Acceptance of terms</h2>
  <p>
    These Terms & Conditions ("Terms") govern your access to and use of Storemate CRM and
