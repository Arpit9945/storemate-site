<script define:vars={{ whatsappNumber }}>
  const form = document.getElementById('contactForm');
  const name = document.getElementById('cf-name');
  const business = document.getElementById('cf-business');
  const phone = document.getElementById('cf-phone');
  const message = document.getElementById('cf-message');
  const interestGroup = document.getElementById('cf-interest');
  const count = document.getElementById('cf-count');

  const groupOf = (el) => el?.closest('.form-group');
  const selectedInterest = () => form?.querySelector('input[name="interest"]:checked');

  message?.addEventListener('input', () => {
    if (count) count.textContent = `${message.value.length} / 1000`;
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const checks = [
      [interestGroup, !!selectedInterest()],
      [groupOf(name), !!name?.value.trim()],
      [groupOf(phone), !!phone?.value.trim()],
      [groupOf(message), !!message?.value.trim()],
    ];

    let firstInvalid = null;
    checks.forEach(([group, ok]) => {
      group?.classList.toggle('is-invalid', !ok);
      if (!ok && !firstInvalid) firstInvalid = group;
    });

    if (firstInvalid) {
      firstInvalid.querySelector('input, textarea')?.focus();
      return;
    }

    // Build WhatsApp message
    const lines = [
      `Hi, I'm *${name.value.trim()}*`,
      business?.value?.trim() ? `from *${business.value.trim()}*` : '',
      ``,
      `📞 Phone: ${phone.value.trim()}`,
      `📌 Interested in: ${selectedInterest().value}`,
      ``,
      `💬 ${message.value.trim()}`,
    ].filter((line, i) => line !== '' || i !== 1);

    const text = encodeURIComponent(lines.join('\n'));
    window.open(`https://wa.me/${whatsappNumber}?text=${text}`, '_blank');
  });

  // Clear the error state as soon as the visitor fixes a field
  form?.addEventListener('input', (e) => groupOf(e.target)?.classList.remove('is-invalid'));
  form?.addEventListener('change', (e) => groupOf(e.target)?.classList.remove('is-invalid'));
</script>
