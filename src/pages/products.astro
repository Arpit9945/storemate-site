---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CornerMarks from '../components/CornerMarks.astro';
import { site } from '../config/site';

const products = [
  {
    slug: '/storemate-crm',
    index: '01',
    name: 'Storemate CRM',
    status: 'Live',
    statusTone: 'live',
    tone: 'crm',
    tagline: 'Jewellery business management, simplified.',
    desc: 'Run inventory, customer records, orders, and GST-ready billing from one place — built around how jewellery is actually bought and sold.',
    points: ['Inventory by weight & purity', 'Customer history in one view', 'GST-ready billing'],
    cta: 'Explore Storemate CRM',
  },
  {
    slug: '/storemate-connect',
    index: '02',
    name: 'Storemate Connect',
    status: 'Instagram live',
    statusTone: 'live',
    tone: 'connect',
    tagline: 'Instagram & WhatsApp automation for your store.',
    desc: 'Auto-reply to Instagram comments, DMs, and story replies the moment a customer asks. WhatsApp broadcast is on the way.',
    points: ['Comment & DM automation', 'Story reply automation', 'WhatsApp messaging'],
    cta: 'Explore Storemate Connect',
  },
];
---

<BaseLayout
  title="Storemate Products | Jewellery CRM & Instagram Automation Software"
  description="Storemateur ready-Storemates for jewellery businesses: Storemate CRM for store management and Storemate Connect for social automation."
  active="products"
>
  <PageHero
    eyebrow="Products"
    title="Ready-made software, built for jewellery businesses."
    lede="Two products, each solving one clear problem — start with the one you need, add the other whenever you're ready."
  />

  <section class="section">
    <div class="container">
      <div class="products-list">
        {products.map((p) => (
          <a href={p.slug} class:list={['product-row', 'corner-frame', 'reveal', { 'corner-frame--connect': p.tone === 'connect' }]}>
            <CornerMarks />
            <div class="product-row__index">{p.index}</div>
            <div class="product-row__body">
              <div class="product-row__top">
                <h2 class="h4">{p.name}</h2>
                <span class:list={['badge', p.statusTone === 'live' ? 'badge--live' : 'badge--soon']}>{p.status}</span>
              </div>
              <p class="product-row__tagline">{p.tagline}</p>
              <p class="product-row__desc">{p.desc}</p>
              <ul class="product-row__points">
                {p.points.map((point) => <li>{point}</li>)}
              </ul>
              <span class:list={['product-row__link', { 'product-row__link--violet': p.tone === 'connect' }]}>{p.cta} &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="services-teaser-heading">
    <div class="container container--narrow" style="text-align: center;">
      <span class="eyebrow">Don't see what you need?</span>
      <h2 id="services-teaser-heading" class="h3" style="margin-top: 0.75rem;">We also build custom software.</h2>
      <p class="lede" style="margin: 1rem auto 2rem;">
        If your business needs something beyond Storemate CRM or Connect, our services team can build it for you.
      </p>
      <a href="/services" class="btn btn--ghost">Explore services</a>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens' as *;

  .products-list {
    display: flex;
    flex-direction: column;
    gap: $space-6;
  }

  .product-row {
    display: flex;
    gap: $space-7;
    padding: $space-8;
    border: 1px solid $line;
    border-radius: $radius-lg;
    transition: transform $dur-base $ease-out, box-shadow $dur-base $ease-out;

    &:hover {
      transform: translateY(-3px);
      box-shadow: $shadow-soft;
    }

    @media (max-width: 720px) {
      flex-direction: column;
      gap: $space-4;
      padding: $space-6;
    }
  }

  .product-row__index {
    font-weight: $fw-black;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: $muted;
    flex-shrink: 0;
  }

  .product-row__top {
    display: flex;
    align-items: center;
    gap: $space-4;
    flex-wrap: wrap;
  }

  .product-row__tagline {
    margin-top: $space-2;
    font-weight: $fw-medium;
    color: $ink;
  }

  .product-row__desc {
    margin-top: $space-3;
    color: $ink-soft;
    max-width: 60ch;
  }

  .product-row__points {
    display: flex;
    flex-wrap: wrap;
    gap: $space-3;
    margin-top: $space-5;

    li {
      font-size: 0.875rem;
      font-weight: $fw-medium;
      color: $ink-soft;
      padding: 0.35rem 0.85rem;
      border: 1px solid $line;
      border-radius: $radius-pill;
    }
  }

  .product-row__link {
    display: inline-block;
    margin-top: $space-6;
    font-weight: $fw-semibold;
    color: $primary;
  }

  .product-row__link--violet { color: $secondary; }
</style>
